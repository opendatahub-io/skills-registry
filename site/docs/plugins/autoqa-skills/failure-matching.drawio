<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="invoke" value="&lt;b&gt;Orchestrator invokes&lt;/b&gt;&lt;br&gt;&lt;br&gt;failure-matching skill&lt;br&gt;/workspace/_context/&lt;br&gt;failure-matching-context.json&lt;br&gt;prepared before run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="30" y="240" width="150" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="read-context" value="&lt;b&gt;Read context first&lt;/b&gt;&lt;br&gt;&lt;br&gt;current_analysis (from failure-analysis)&lt;br&gt;historical_tickets[]: ticket_id, summary, likely_cause&lt;br&gt;same test label" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="230" y="240" width="185" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="compare" value="&lt;b&gt;Compare &amp; match&lt;/b&gt;&lt;br&gt;LLM&lt;br&gt;&lt;br&gt;compare current vs each ticket&lt;br&gt;deterministic &amp; concise&lt;br&gt;minor wording still matches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333333;strokeWidth=3;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;double=1;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="465" y="240" width="175" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="clear-match" value="&lt;b&gt;Clearly same failure?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=12;fontFamily=Inter,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
      <mxGeometry x="690" y="230" width="140" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="pick-ticket" value="&lt;b&gt;Use candidate ticket_id&lt;/b&gt;&lt;br&gt;&lt;br&gt;set from candidate list&lt;br&gt;never invent an ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="880" y="60" width="175" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="no-match" value="&lt;b&gt;ticket_id = null&lt;/b&gt;&lt;br&gt;&lt;br&gt;no candidate clearly matches&lt;br&gt;actual JSON null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="880" y="430" width="175" height="110" as="geometry"/>
