direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

invoke: |md
  **Orchestrator invokes**

  - failure-matching skill
  - /workspace/_context/
    failure-matching-context.json
  - prepared before run
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Read context ---

read-context: |md
  **Read context first**

  - current_analysis
    (from failure-analysis)
  - historical_tickets[]:
    ticket_id, summary, likely_cause
  - same test label
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Compare (LLM) ---

compare: |md
  **Compare & match**
  LLM

  - compare current vs each ticket
  - deterministic & concise
  - minor wording still matches
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Decision: clear match ---

clear-match: |md
  **Clearly same
  failure?**
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Branches ---

pick-ticket: |md
  **Use candidate ticket_id**

  - set from candidate list
  - never invent an ID
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

no-match: |md
  **ticket_id = null**

  - no candidate clearly matches
  - actual JSON null
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Write verdict (output) ---

write-verdict: |md
  **Write verdict.json**

  - { "ticket_id": ... }
  - JSON only, no fences
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Validation (external CLIs) ---

schema-val: |md
  **write_json.py**

  - JSON Schema validation
  - failure-matching-verdict.json
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

sem-val: |md
  **validate_verdict.py**

  - semantic validation
  - against context file
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Decision: valid ---

valid: |md
  **Valid?**
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Final artifact ---

done: |md
  **verdict.json**

  - final artifact
  - { ticket_id }
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Flow ---

invoke -> read-context
read-context -> compare
compare -> clear-match

clear-match -> pick-ticket: "yes"
clear-match -> no-match: "no"

pick-ticket -> write-verdict
no-match -> write-verdict

write-verdict -> schema-val
schema-val -> sem-val
sem-val -> valid

valid -> done: "pass"
valid -> write-verdict: "fix & re-validate" {
  style.stroke-dash: 3
}
