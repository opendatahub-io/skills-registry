<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="invoke" value="&lt;b&gt;Orchestrator invokes&lt;/b&gt;&lt;br&gt;&lt;br&gt;failure-analysis-context.json&lt;br&gt;test.log prepared&lt;br&gt;under /workspace/_context/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="325" width="170" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="read-context" value="&lt;b&gt;Read context first&lt;/b&gt;&lt;br&gt;&lt;br&gt;load context.json&lt;br&gt;test_name, plan, result&lt;br&gt;log at _context/test.log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="260" y="335" width="190" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="analyze" value="&lt;b&gt;Analyze the log&lt;/b&gt;&lt;br&gt;LLM analysis&lt;br&gt;&lt;br&gt;read last ~100 lines, then earlier&lt;br&gt;errors, stack traces, assertions&lt;br&gt;timeouts, dependency errors&lt;br&gt;cleanup/log-collection run AFTER failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333333;strokeWidth=3;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;double=1;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="500" y="320" width="220" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="resolver" value="&lt;b&gt;Resolver tree present?&lt;/b&gt;&lt;br&gt;&lt;br&gt;TRACE Resolver derivation tree after reduction" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=12;fontFamily=Inter,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
      <mxGeometry x="770" y="335" width="180" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="extract-tree" value="&lt;b&gt;Extract resolver tree&lt;/b&gt;&lt;br&gt;&lt;br&gt;lines after TRACE marker&lt;br&gt;resolved dependency graph&lt;br&gt;into root_cause_snippet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="765" y="140" width="190" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="write-verdict" value="&lt;b&gt;Write verdict.json&lt;/b&gt;&lt;br&gt;&lt;br&gt;summary, likely_cause&lt;br&gt;root_cause_snippet&lt;br&gt;(verbatim L&lt;num&gt;: lines)&lt;br&gt;confidence: high / medium / low" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="1025" y="320" width="200" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="validate" value="&lt;b&gt;Validate verdict&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ececec;strokeColor=#333333;strokeWidth=2;container=1;collapsible=0;verticalAlign=top;spacingTop=5;fontSize=12;fontStyle=1;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="1290" y="250" width="243" height="300" as="geometry"/>
    </mxCell>
    <mxCell id="schema-val" value="&lt;b&gt;write_json.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;JSON Schema validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333333;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=middle;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="validate">
      <mxGeometry x="25" y="60" width="200" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="sem-val" value="&lt;b&gt;validate_verdict.py&lt;/b&gt;&lt;br&gt;&lt;br&gt;semantic validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333333;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=middle;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="validate">
      <mxGeometry x="25" y="180" width="200" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="valid" value="&lt;b&gt;Valid?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=12;fontFamily=Inter,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
      <mxGeometry x="1600" y="340" width="150" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="done" value="&lt;b&gt;verdict.json&lt;/b&gt;&lt;br&gt;&lt;br&gt;final artifact&lt;br&gt;/workspace/verdict.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
