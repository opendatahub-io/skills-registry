direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **architecture-review**
  fork · model: opus

  - platform architect
  - reviews refined
    strategy features
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Read inputs ---

read-inputs: |md
  **Read Inputs**

  - artifacts/strat-tasks/
  - cross-ref
    artifacts/rfe-tasks/
  - prior strat-reviews/
    if re-review
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Decision ---

archctx-q: |md
  **Arch context
  available?**

  rhoai-* dir present?
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Load overlays ---

overlays: |md
  **Load Overlays**

  - active overlays only
  - override generated docs
  - e.g. KFP SDK version
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Assess (LLM) ---

assess: |md
  **Assess Architecture**
  LLM (opus)

  - dependencies accurate?
  - integration patterns valid?
  - component boundaries?
  - deployment model correct?
  - conflicts + cross-component
    coordination?
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Result ---

result: |md
  **STRAT-NNN assessment**

  - architecture assessment
  - missing dependencies
  - incorrect assumptions
  - cross-component risks
  - recommendation
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- External context ---

archctx: |md
  **architecture-context**

  - PLATFORM.md
  - component docs
  - overlays
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Flow ---

entry -> read-inputs
read-inputs -> archctx-q

archctx-q -> overlays: "available"
archctx-q -> result: "unavailable\nskipped" {
  style.stroke-dash: 3
}

overlays -> assess
assess -> result

read-inputs -> archctx: {
  style.stroke-dash: 3
}
