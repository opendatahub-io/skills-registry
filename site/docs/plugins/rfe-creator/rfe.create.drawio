<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="entry" value="&lt;b&gt;/rfe.create&lt;/b&gt;&lt;br&gt;&lt;br&gt;problem statement&lt;br&gt;--headless&lt;br&gt;--priority, --labels&lt;br&gt;--rfe-id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="30" y="250" width="150" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="parse" value="&lt;b&gt;Step 0: Parse Args&lt;/b&gt;&lt;br&gt;&lt;br&gt;extract flags + problem text&lt;br&gt;--headless skips Step 2&lt;br&gt;remaining text = problem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="225" y="270" width="175" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="assess-rfe" value="&lt;b&gt;assess-rfe plugin&lt;/b&gt;&lt;br&gt;&lt;br&gt;bootstrap-assess-rfe.sh&lt;br&gt;/export-rubric" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333333;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=middle;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="452" y="60" width="170" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="load-rubric" value="&lt;b&gt;Step 1: Load Rubric&lt;/b&gt;&lt;br&gt;&lt;br&gt;read artifacts/rfe-rubric.md&lt;br&gt;if missing: bootstrap&lt;br&gt;shapes questions + RFEs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="445" y="260" width="185" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="headless-q" value="&lt;b&gt;--headless?&lt;/b&gt;&lt;br&gt;&lt;br&gt;skip clarifying Q's?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=12;fontFamily=Inter,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
      <mxGeometry x="675" y="270" width="140" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="clarify" value="&lt;b&gt;Step 2: Clarifying Questions&lt;/b&gt;&lt;br&gt;&lt;br&gt;2-5 Q's (AskUserQuestion)&lt;br&gt;customers, business justification&lt;br&gt;user problem, size, success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="860" y="255" width="185" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="generate" value="&lt;b&gt;Step 3: Generate RFEs&lt;/b&gt;&lt;br&gt;&lt;br&gt;WHAT/WHY, never HOW&lt;br&gt;one RFE per business need&lt;br&gt;size S/M/L/XL from AC count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333333;strokeWidth=3;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;double=1;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="1090" y="255" width="195" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="write" value="&lt;b&gt;Step 4: Write Artifacts&lt;/b&gt;&lt;br&gt;&lt;br&gt;next_rfe_id.py or --rfe-id&lt;br&gt;frontmatter.py set (Draft)&lt;br&gt;rebuild-index" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="1330" y="255" width="185" height="150" as="geometry"/>
