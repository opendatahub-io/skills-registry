direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/rfe.submit**

  - --dry-run
  - --artifacts-dir
  - non-interactive
    (invoking = confirmation)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Credentials gate ---

creds-q: |md
  **JIRA env vars set?**

  - JIRA_SERVER
  - JIRA_USER / JIRA_TOKEN
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Submission ---

submit-script: |md
  **Step 1: Run Submission**

  - scripts/submit.py
  - REST API + Basic Auth
    (deterministic, not MCP)
  - create new / update existing
  - auto-apply labels
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- External Jira ---

jira: |md
  **Jira (RHAIRFE)**

  - create Feature Request
  - update existing tickets
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Report ---

report: |md
  **Step 2: Report**

  - read artifacts/rfes.md
    (rebuilt by script)
  - report results
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Labels callout ---

labels: |md
  rfe-creator-auto-created
  rfe-creator-auto-revised
  rfe-creator-split-original
  rfe-creator-split-result
  rfe-creator-needs-attention
  rfe-creator-autofix-rubric-pass
  rfe-creator-feasibility-pass
  rfe-creator-feasibility-fail
  rfe-creator-feasibility-unknown
  (feasibility-* mutually exclusive)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

entry -> creds-q
creds-q -> submit-script: "set"
creds-q -> report: "missing →\ninstruct & stop" {
  style.stroke-dash: 3
}
submit-script -> jira: "create / update" {
  style.stroke-dash: 3
}
submit-script -> report
submit-script -> labels: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
