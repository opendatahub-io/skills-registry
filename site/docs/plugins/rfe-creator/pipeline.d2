direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **User invocation**

  - free-text idea
  - Jira key (RHAIRFE-1234)
  - --input batch.yaml
  - --type initiative
  - --headless / --dry-run
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Shared type registry + launch block (Step 0 of every skill) ---

type-registry: |md
  **Work-item type registry**

  - types/{t}/type.yaml, data only
  - rfe to RHAIRFE Feature Request
  - initiative to RHOAIENG Initiative
  - types/_schema/type.schema.json
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

launch-block: |md
  **Step 0 of every skill**

  - scripts/bootstrap.sh --layout
  - type_registry.py resolve
  - TYPE RESOLVED: {type} ({how})
  - launch-vars {type} {stage}
  - renders every {VAR} in the body
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

launch-vars: |md
  $ launch-vars rfe review
  TYPE=rfe
  TYPE_FLAG=--type rfe
  ENTITY=RFE
  ID_FIELD=rfe_id
  LOCAL_PREFIX=RFE-
  KEY_PREFIX=RHAIRFE-
  TASKS_DIR=artifacts/rfe-tasks
  REVIEWS_DIR=artifacts/rfe-reviews
  SCORER_AGENT=rfe-scorer
  DIMENSIONS=feasibility
  RESPLIT_FIELD=right_sized
  RESPLIT_BELOW=2
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Vendored dependencies ---

update-deps: |md
  **/rfe-creator.update-deps**
  side utility, not model-invocable

  - removes .context/assess-rfe
  - + the vendored assess-rfe skills
  - and .context/architecture-context
  - re-runs bootstrap.sh + fetch
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

vendored: |md
  **Vendored context**

  - assess-rfe at pipeline.rubric.ref
  - .context/assess-rfe/ scorer prompt
  - artifacts/rfe-rubric.md export
  - .context/architecture-context/
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Orchestrator ---

skill-speedrun: |md
  **/rfe-speedrun**
  end-to-end orchestrator

  - Mode A: --input batch.yaml
  - Mode B: existing Jira key
  - Mode C: single idea
  - Phase 1 create, 2 auto-fix,
  - 3 submit, 4 summary
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Create / drive ---

skill-create: |md
  **/rfe-create**

  - {t}/prompts/create-guidance.md
  - {t}/template.md into the body
  - next_rfe_id.py allocates the ID
  - frontmatter.py set status=Draft
  - 2-5 questions unless --headless
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

skill-autofix: |md
  **/rfe-auto-fix**
  non-interactive batch driver

  - pipeline_state.py, 31 phases
  - BATCH_START through DONE
  - next-action, launch_wave
  - wait-for-wave barrier, exit 3
  - --jql / --batch-size 50
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Review and right-size (the quality loop) ---

quality: Review and right-size {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  skill-review: |md
    **/rfe-review**

    - fetch agent, MCP or REST
    - rfe-scorer assess + feasibility
    - review-agent writes the verdict
    - revise-agent fixes what it can
    - re-assess, max 2 cycles
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 2
    style.double-border: true
  }

  skill-split: |md
    **/rfe-split**

    - {t}/prompts/split-rules.md
    - split agent per parent ID
    - collect_children.py
    - re-split if right_sized below 2
    - 1 correction cycle max
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 2
    style.double-border: true
  }

  skill-review -> skill-split: "recommendation: split"
  skill-split -> skill-review: "children, --caller split" {
    style.stroke-dash: 3
  }
}

# --- Submit and outputs ---

skill-submit: |md
  **/rfe-submit**

  - submit.py --hold-interrupted
  - creates or updates the ticket
  - RFE-001.md renamed to the key
  - applies the rfe-creator-* labels
  - --dry-run validates locally
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

jira: |md
  **Jira**

  - REST API (JIRA_SERVER / TOKEN)
  - RHAIRFE Feature Request
  - RHOAIENG Initiative
  - Atlassian MCP for reads
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

run-report: |md
  **Run reports**

  - batch_summary.py counts
  - artifacts/auto-fix-runs/{ts}.yaml
  - {ts}-report.html review report
  - speedrun Phase 4 summary
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

artifacts-tree: |md
  artifacts/
    rfe-rubric.md (assess-rfe)
    rfes.md (generated index)
    rfe-tasks/
      RFE-001.md
      RHAIRFE-1595.md
      RHAIRFE-1595-comments.md
    rfe-originals/
      RHAIRFE-1595.md
    rfe-reviews/
      RFE-001-review.md
      RFE-001-split-status.yaml
    initiatives/
      INIT-001.md
    initiative-originals/
    initiative-reviews/
      INIT-001-review.md
    auto-fix-runs/
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Legacy dotted aliases ---

aliases: Legacy dotted aliases {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  alias-create: |md
    **/rfe.create**
    to /rfe-create
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 2
    style.stroke-dash: 3
  }
  alias-review: |md
    **/rfe.review**
    to /rfe-review
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 2
    style.stroke-dash: 3
  }
  alias-split: |md
    **/rfe.split**
    to /rfe-split
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 2
    style.stroke-dash: 3
  }
  alias-submit: |md
    **/rfe.submit**
    to /rfe-submit
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 2
    style.stroke-dash: 3
  }
  alias-speedrun: |md
    **/rfe.speedrun**
    to /rfe-speedrun
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 2
    style.stroke-dash: 3
  }
  alias-autofix: |md
    **/rfe.auto-fix**
    to /rfe-auto-fix
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 2
    style.stroke-dash: 3
  }
}

# --- Flow ---

entry -> launch-block: "idea / Jira key / batch.yaml"
type-registry -> launch-block: "descriptor"
launch-block -> skill-speedrun: "KEY=value launch block"

aliases -> launch-block: "reads the sibling SKILL.md" {
  style.stroke-dash: 3
}

skill-speedrun -> skill-create: "Phase 1, Agent per entry"
skill-create -> skill-autofix: "Phase 2, Skill tool"
skill-create -> quality: "rfe-tasks/{ID}.md"

skill-autofix -> quality: "same prompts" {
  style.stroke-dash: 3
}

update-deps -> vendored: "re-vendor at the pinned sha"
vendored -> quality: "artifacts/rfe-rubric.md"

quality -> skill-submit: "SUBMIT= line"
skill-submit -> jira: "create or update"
jira -> quality: "fetch issue" {
  style.stroke-dash: 3
}

skill-autofix -> run-report: "artifacts/auto-fix-runs/"

# --- Callout connectors ---

launch-block -> launch-vars: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}

skill-autofix -> artifacts-tree: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
