direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

user-input: |md
  **User input**

  - single idea (free text)
  - Jira key(s) RHAIRFE-NNNN
  - batch YAML (--input)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Orchestrator (LLM) ---

speedrun: |md
  **/rfe.speedrun**
  orchestrator (LLM)

  - detect Mode A / B / C
  - persist config + IDs to tmp/
  - --headless / --dry-run
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Phase 1: Create (LLM) ---

create: |md
  **/rfe.create**
  Phase 1 (LLM)

  - clarify need (WHAT/WHY)
  - size from acceptance criteria
  - writes rfe-tasks/RFE-NNN.md
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Phase 2: Auto-fix (LLM) ---

auto-fix: |md
  **/rfe.auto-fix**
  Phase 2 (LLM)

  - pipeline_state.py state machine
  - batches, resume, retry queue
  - non-interactive
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Review (LLM) ---

review: |md
  **/rfe.review**
  review orchestrator (LLM)

  - rubric score + feasibility
  - launches agents (rfe-scorer)
  - auto-revise + re-assess
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Split (LLM) ---

split-skill: |md
  **/rfe.split**
  decompose (LLM)

  - split oversized RFEs
  - generate children
  - coverage self-check
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Submit (deterministic) ---

submit-skill: |md
  **/rfe.submit**
  deterministic

  - scripts/submit.py
  - REST + BasicAuth
  - create / update tickets
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- External dependencies (dashed) ---

assess-rfe: |md
  **assess-rfe plugin**

  - rubric / export-rubric
  - rfe-scorer agent
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

arch-context: |md
  **architecture-context**

  - repo checkout
  - feasibility context
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

jira-out: |md
  **Jira (RHAIRFE)**

  - Feature Request
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Shared store ---

artifacts-store: |md
  **artifacts/ (shared store)**

  - rfe-tasks/ , rfe-originals/
  - rfe-reviews/ , rfes.md
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Callouts ---

artifacts-tree: |md
  artifacts/
    rfe-tasks/RFE-NNN.md      (task + frontmatter)
    rfe-originals/RHAIRFE-*.md  (Jira baseline)
    rfe-reviews/{ID}-review.md (score/pass/rec)
    rfes.md                    (generated index)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

review-file: |md
  {ID}-review.md frontmatter:
    score  pass  recommendation
    feasibility  auto_revised
    needs_attention
    scores: what why open_to_how
            not_a_task right_sized
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

user-input -> speedrun: "idea / keys /\nbatch YAML"
speedrun -> create: "Mode A/C:\nnew RFEs"
create -> auto-fix: "RFE-NNN.md"
auto-fix -> review: "invokes"
review -> submit-skill: "passing RFEs"
submit-skill -> jira-out: "REST + BasicAuth"

# Branch + loops
auto-fix -> split-skill: "oversized"
split-skill -> review: "children\n(re-review)"
review -> review: "auto-revise\n(<=2 cycles)" {
  style.stroke-dash: 3
}

# External (dashed)
review -> assess-rfe: "rubric /\nrfe-scorer" {
  style.stroke-dash: 3
}
review -> arch-context: "feasibility\ncontext" {
  style.stroke-dash: 3
}

# Orchestration (speedrun drives phases directly)
speedrun -> auto-fix: "Mode B:\nexisting keys" {
  style.stroke-dash: 3
}
speedrun -> submit-skill: "Phase 3\n(drives)" {
  style.stroke-dash: 3
}

# Store + callouts
create -> artifacts-store: "writes\nRFE files"
artifacts-store -> artifacts-tree: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
submit-skill -> review-file: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
