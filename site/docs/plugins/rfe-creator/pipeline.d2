direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **RFE Pipeline**

  - single idea (Mode C)
  - Jira key(s) (Mode B)
  - batch YAML (Mode A)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Orchestrator ---

speedrun: |md
  **/rfe.speedrun**
  top-level orchestrator

  - 3 modes (A/B/C)
  - persists state to tmp/
  - chains create -> auto-fix -> submit
  - --headless / --dry-run for CI
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 3
  style.double-border: true
}

# --- Create ---

create: |md
  **/rfe.create**
  author RFE artifacts

  - clarifying questions
  - RFE template, WHAT/WHY only
  - size guide (S/M/L)
  - -> artifacts/rfe-tasks
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 3
  style.double-border: true
}

# --- Auto-fix ---

autofix: |md
  **/rfe.auto-fix**
  non-interactive pipeline

  - pipeline_state.py machine
  - batched agent dispatch
  - assess -> feasibility ->
    review -> revise -> split
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 3
  style.double-border: true
}

# --- Review ---

review: |md
  **/rfe.review**
  score + revise

  - rubric assess + feasibility
  - review + auto-revise
  - re-assess <= 2 cycles
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 3
  style.double-border: true
}

# --- Split ---

split: |md
  **/rfe.split**
  decompose oversized RFEs

  - split into children
  - re-review children
  - right-size loop
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 3
  style.double-border: true
}

# --- Submit ---

submit-skill: |md
  **/rfe.submit**
  deterministic REST API

  - passing IDs only
  - create / update tickets
  - auto-applied labels
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- External dependencies ---

assess-rfe: |md
  **assess-rfe plugin**

  - scoring rubric
  - bootstrapped on first use
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

archctx: |md
  **architecture-context**

  - platform components / APIs
  - feasibility grounding
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

jira: |md
  **Jira (RHAIRFE)**

  - fetch existing RFEs
  - create + update tickets
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Output ---

result: |md
  **RHAIRFE tickets**

  - created / updated
  - labels: auto-created,
    auto-revised, split-*,
    feasibility-*
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Flow ---

entry -> speedrun

speedrun -> create: "Mode A/C: new ideas"
speedrun -> autofix: "existing keys /\nafter create"
create -> autofix: "artifacts/rfe-tasks"

autofix -> review: "per batch"
autofix -> split: "oversized"
split -> review: "review children" {
  style.stroke-dash: 3
}

review -> assess-rfe: "rubric" {
  style.stroke-dash: 3
}
review -> archctx: "feasibility grounding" {
  style.stroke-dash: 3
}
review -> jira: "fetch RFEs" {
  style.stroke-dash: 3
}

speedrun -> submit-skill: "passing IDs"
submit-skill -> jira: "create / update" {
  style.stroke-dash: 3
}
jira -> result
