<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="entry" value="&lt;b&gt;/rfe.split&lt;/b&gt;&lt;br&gt;&lt;br&gt;RHAIRFE-NNNN / RFE-NNN IDs&lt;br&gt;one or more parents&lt;br&gt;--headless flag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="30" y="110" width="160" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="parse" value="&lt;b&gt;Step 0: Parse &amp; Persist&lt;/b&gt;&lt;br&gt;&lt;br&gt;strip --headless flag&lt;br&gt;IDs + flags to disk (state.py)&lt;br&gt;verify task files exist (Glob)&lt;br&gt;skip missing artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="240" y="110" width="180" height="140" as="geometry"/>
    </mxCell>
