      <mxGeometry x="470" y="110" width="180" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="collect-q" value="&lt;b&gt;action: split?&lt;/b&gt;&lt;br&gt;&lt;br&gt;collect_children.py&lt;br&gt;read split-status.yaml" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=12;fontFamily=Inter,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
      <mxGeometry x="700" y="120" width="160" height="120" as="geometry"/>
    </mxCell>
