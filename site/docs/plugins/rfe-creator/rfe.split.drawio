    <mxCell id="parse" value="&lt;b&gt;Step 0 - Parse + Persist&lt;/b&gt;&lt;br&gt;&lt;br&gt;state.py init split-config.yaml&lt;br&gt;state.py write-ids split-all-ids.txt&lt;br&gt;reads only frontmatter + Glob,&lt;br&gt;never RFE bodies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
