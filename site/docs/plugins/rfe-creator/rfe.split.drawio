      <mxGeometry x="515" y="230" width="245" height="340" as="geometry"/>
    </mxCell>
    <mxCell id="agent" value="&lt;b&gt;Split Agent&lt;/b&gt;&lt;br&gt;opus, background&lt;br&gt;&lt;br&gt;prompts/split-agent.md per parent&lt;br&gt;reads RFE body, decomposes&lt;br&gt;writes {ID}-split-status.yaml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333333;strokeWidth=3;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;double=1;arcSize=16;absoluteArcSize=1;" vertex="1" parent="split">
      <mxGeometry x="27" y="50" width="200" height="150" as="geometry"/>
    </mxCell>
