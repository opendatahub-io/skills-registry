direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/rfe.split**

  - {IDs} (RHAIRFE / RFE-NNN)
  - [--headless]
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 0: Parse + persist ---

parse: |md
  **Step 0 · Parse + Persist**

  - state.py init split-config.yaml
  - state.py write-ids split-all-ids.txt
  - orchestrator reads only
    frontmatter + Glob, never bodies
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

verify: |md
  **Task file exists?**

  - Glob rfe-tasks/{ID}.md
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

skip-step: |md
  **Skip Missing**

  - report ID, drop it
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 1: Split agents ---

split: Step 1 · Split Agents {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  agent: |md
    **Split Agent**
    opus · background

    - prompts/split-agent.md
      per parent
    - reads RFE body, decomposes
    - writes {ID}-split-status.yaml
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 3
    style.double-border: true
  }

  poll: |md
    **Poll Progress**

    - check_review_progress.py
      --phase split
    - sleep NEXT_POLL
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  agent -> poll
}

# --- Step 2: Collect children ---

action: |md
  **action?**

  - read {ID}-split-status.yaml
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

revise: |md
  **Mark Revise**

  - frontmatter set
    recommendation=revise
  - (delivery-coupled)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

collect: |md
  **Step 2 · Collect Children**

  - collect_children.py
  - parse child RFE IDs
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

review: |md
  **/rfe.review**
  other skill

  - --caller split [--headless]
  - full review pipeline
    on children
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Step 3: Right-sizing self-correction ---

rightsize: |md
  **child right_sized < 2/2?**

  - frontmatter read {child}-review.md
  - state.py correction_cycle (max 1)
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 4: Finalize ---

finalize: |md
  **Step 4 · Finalize**

  - frontmatter.py rebuild-index
  - state.py read split-config.yaml
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

summary: |md
  **Interactive Summary**

  - parent archived
  - children PASS / FAIL
  - coverage report
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

autofix: |md
  **/rfe.auto-fix**
  other skill

  - Step 3d between-batch
  - headless return
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Callout ---

status-yaml: |`md
  rfe-reviews/{ID}-split-status.yaml:
    status: completed
    action: split | no-split
    reason: "split into N children" | "delivery-coupled"
    children: [RFE-001, RFE-002]
`| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

entry -> parse
parse -> verify
verify -> skip-step: "missing"
verify -> split.agent: "exists"

split.poll -> action: "split-status.yaml"
action -> revise: "no-split"
action -> collect: "split"
collect -> review: "child IDs"
review -> rightsize: "right_sized"

rightsize -> split.agent: "re-split child" {
  style.stroke-dash: 3
}
rightsize -> finalize: "all >= 2/2"
revise -> finalize

finalize -> summary: "interactive"
finalize -> autofix: "--headless" {
  style.stroke-dash: 3
}

collect -> status-yaml: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
