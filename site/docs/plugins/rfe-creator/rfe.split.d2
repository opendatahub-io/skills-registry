direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/rfe.split**

  - RHAIRFE-NNNN / RFE-NNN IDs
  - one or more parents
  - --headless flag
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 0 ---

parse: |md
  **Step 0: Parse & Persist**

  - strip --headless flag
  - IDs + flags to disk (state.py)
  - verify task files exist (Glob)
  - skip missing artifacts
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 1 (LLM) ---

split-agents: |md
  **Step 1: Split Agents**

  - parallel agents (Opus, bg)
  - one per parent RFE
  - decompose into children
  - poll check_review_progress
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 3
  style.double-border: true
}

# --- Step 2 decision ---

collect-q: |md
  **action: split?**

  - collect_children.py
  - read split-status.yaml
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Review (other skill) ---

review-children: |md
  **/rfe.review --caller split**

  - full review pipeline
  - all children reviewed
  - --headless passthrough
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Step 3 decision ---

rightsize-q: |md
  **child < 2/2 right-sized?**

  - Step 3 self-correction
  - max 1 cycle
  - right_sized score only
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 4 container ---

finalize: "Step 4: Finalize" {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  headless: |md
    **Headless Return**

    - rebuild index
    - return to /rfe.auto-fix
    - batch loop (no summary)
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  interactive: |md
    **Interactive Summary**

    - parents archived
    - list new RFEs + PASS
    - coverage report
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }
}

# --- Output ---

result: |md
  **artifacts/rfe-tasks/**

  - child RFEs created
  - parent status=Archived
  - next: /rfe.submit
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Flow ---

entry -> parse
parse -> split-agents
split-agents -> collect-q

collect-q -> review-children: "split"
collect-q -> result: "no-split -> revise" {
  style.stroke-dash: 3
}

review-children -> rightsize-q
rightsize-q -> split-agents: "re-split offending child" {
  style.stroke-dash: 3
}
rightsize-q -> finalize: "ok or max 1 cycle"
finalize -> result
