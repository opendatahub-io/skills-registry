direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry: forked reviewer sub-agent (STRATEGY workflow) ---

entry: |md
  **Forked review sub-agent**
  product owner — right-sizing (opus)

  - context: fork
  - user-invocable: false
  - allowed-tools: Read, Grep, Glob
  - reviews strategy features
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Read strategy inputs, cross-ref source RFEs ---

inputs: |md
  **Read inputs**

  - artifacts/strat-tasks/ (refined
    strategy features)
  - cross-ref artifacts/rfe-tasks/
    (source RFEs)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Re-review decision ---

re-review: |md
  **strat-reviews/ has files
  for these strategies?**
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

rereview-delta: |md
  **Re-review delta**

  - concerns addressed?
  - concerns remaining?
  - new issues introduced?
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Assess: the single LLM sub-agent reasoning step + 6 scope dimensions ---

assess: Assess (6 dimensions) {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  reason: |md
    **Product-owner reasoning**
    LLM sub-agent (opus)

    - right-size each strategy
    - not 3 bundled, not a task
    - deliver the RFE, no more
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 3
    style.double-border: true
  }
  d1-sized: |md
    **1. Right-sized?**
    one deliverable feature
  |
  d2-effort: |md
    **2. Effort vs scope**
    M but 5 comp / 3 teams = L/XL?
  |
  d3-bounded: |md
    **3. Scope bounded?**
    in / out of scope explicit
  |
  d4-complete: |md
    **4. Complete capability?**
    usable, not partial delivery
  |
  d5-risks: |md
    **5. Scope risks**
    flag scope-trap phrases
  |
  d6-coverage: |md
    **6. RFE coverage**
    expands / shrinks vs criteria?
  |
}

# --- Output ---

assessment-out: |md
  **Return assessment**

  - one block per strategy
  - split? concrete boundaries
    per resulting strategy
  - no Write tool: returned
    to orchestrator
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Callouts ---

scope-block: |md
  ### STRAT-NNN: {title}
  Scope assessment:
    right-sized / too large - split /
    too small / unbounded
  Effort vs scope:
    matched / underestimated /
    overestimated
  RFE coverage:
    full / partial - gaps listed /
    exceeds RFE
  Scope risks: [... or none identified]
  Recommendation:
    approve / split into N strategies /
    tighten scope / expand to deliver RFE
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

scope-traps: |md
  Scope-trap phrases (dim 5)
  "and related functionality"
  "all necessary changes"
  "full support for"
  => flag as unbounded scope
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

entry -> inputs: "strat-tasks/*.md"
inputs -> re-review: "rfe-tasks/*.md cross-ref"
re-review -> rereview-delta: "strat-reviews/" {
  style.stroke-dash: 3
}
re-review -> assess: "acceptance criteria"
rereview-delta -> assess
assess -> assessment-out: "STRAT-NNN block"

# Callout connectors
assessment-out -> scope-block {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
assess -> scope-traps {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
