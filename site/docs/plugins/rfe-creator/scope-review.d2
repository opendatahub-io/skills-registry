direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry (forked sub-agent) ---

entry: |md
  **scope-review**

  - context: fork · model opus
  - product-owner reviewer
  - refined strategy features
  - tools: Read, Grep, Glob
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Read inputs ---

read-inputs: |md
  **Read Inputs**

  - artifacts/strat-tasks/
  - cross-ref artifacts/rfe-tasks/
  - prior strat-reviews/
    if re-review
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Assess (LLM) ---

assess: |md
  **Assess Scope**

  - right-sized? (feature,
    not 3 bundled / not a task)
  - effort matches scope?
  - bounded? in / out explicit
  - complete capability?
  - scope traps ("and related",
    "full support for")
  - silently expand/shrink RFE?
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Decision ---

verdict-q: |md
  **Recommendation**

  - approve
  - split into N
  - tighten scope
  - expand to deliver RFE
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Output ---

result: |md
  **STRAT-NNN assessment**

  - scope assessment
  - effort vs scope
  - RFE coverage
  - scope risks
  - recommendation
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Callout: output template ---

out-template: |md
  ### STRAT-NNN: <title>
  Scope: right-sized / split / small
  Effort vs scope: matched / under / over
  RFE coverage: full / partial / exceeds
  Scope risks: <list>
  Recommendation: approve / split into N
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

entry -> read-inputs
read-inputs -> assess
assess -> verdict-q

verdict-q -> result: "split → boundaries"

result -> out-template: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
