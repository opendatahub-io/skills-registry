    <mxCell id="overlays" value="&lt;b&gt;Apply overlays&lt;/b&gt;&lt;br&gt;&lt;br&gt;overlays/*.md status: active&lt;br&gt;filter release + affects&lt;br&gt;(platform matches all)&lt;br&gt;overlays take precedence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="745" y="260" width="180" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="degrade" value="&lt;b&gt;Degrade gracefully&lt;/b&gt;&lt;br&gt;&lt;br&gt;Read error = file missing&lt;br&gt;assess on RFE content alone&lt;br&gt;state: context unavailable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="990" y="265" width="190" height="130" as="geometry"/>
