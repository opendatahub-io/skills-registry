    <mxCell id="inputs" value="&lt;b&gt;Read RFE inputs&lt;/b&gt;&lt;br&gt;&lt;br&gt;artifacts/rfe-tasks/{ID}.md&lt;br&gt;{ID}-comments.md (if present)&lt;br&gt;= Jira stakeholder history&lt;br&gt;prior decisions, related work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
