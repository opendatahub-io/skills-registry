    <mxCell id="report-schema" value="artifacts/rfe-reviews/{ID}-feasibility.md&lt;br&gt;### RFE-NNN: {title}&lt;br&gt;Feasibility:&lt;br&gt;&amp;nbsp;&amp;nbsp;feasible / infeasible / indeterminate&lt;br&gt;Strategy considerations:&lt;br&gt;&amp;nbsp;&amp;nbsp;none / items for /strat.refine&lt;br&gt;Blockers:&lt;br&gt;&amp;nbsp;&amp;nbsp;none / list&lt;br&gt;Scope assessment:&lt;br&gt;&amp;nbsp;&amp;nbsp;appropriate / needs splitting / unclear" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;strokeWidth=1;verticalAlign=top;spacingTop=5;align=left;spacingLeft=8;fontSize=10;fontFamily=JetBrains Mono,Courier New,monospace;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
