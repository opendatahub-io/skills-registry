<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="entry" value="&lt;b&gt;Launched by /rfe.review&lt;/b&gt;&lt;br&gt;&lt;br&gt;internal sub-agent (opus)&lt;br&gt;user-invocable: false&lt;br&gt;1 of 2N review agents&lt;br&gt;input: RFE {ID}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333333;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=middle;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
