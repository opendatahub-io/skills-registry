<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="entry" value="&lt;b&gt;/rfe-submit&lt;/b&gt;&lt;br&gt;&lt;br&gt;--type {t} (rfe, initiative)&lt;br&gt;--dry-run, --headless&lt;br&gt;explicit IDs&lt;br&gt;non-interactive: invoking IS the confirmation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="250" width="175" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="step0" value="&lt;b&gt;Step 0: Layout + Type&lt;/b&gt;&lt;br&gt;&lt;br&gt;bash scripts/bootstrap.sh --layout&lt;br&gt;(links scripts/ + types/; exit 3 = already there)&lt;br&gt;type_registry.py resolve [--type {t}] [--headless] {IDs}&lt;br&gt;launch-vars {type} submit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="265" y="245" width="215" height="170" as="geometry"/>
    </mxCell>
    <mxCell id="creds" value="&lt;b&gt;JIRA_SERVER /&lt;br&gt;JIRA_USER /&lt;br&gt;JIRA_TOKEN set?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=12;fontFamily=Inter,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
      <mxGeometry x="530" y="270" width="195" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="creds-help" value="&lt;b&gt;Print Setup, Stop&lt;/b&gt;&lt;br&gt;&lt;br&gt;export JIRA_SERVER, JIRA_USER, JIRA_TOKEN&lt;br&gt;id.atlassian.com token page&lt;br&gt;re-run /rfe-submit &amp;mdash; nothing is submitted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="525" y="450" width="205" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="mode" value="&lt;b&gt;--headless&lt;br&gt;parsed?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=12;fontFamily=Inter,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
      <mxGeometry x="775" y="272" width="185" height="116" as="geometry"/>
    </mxCell>
    <mxCell id="run-interactive" value="&lt;b&gt;Interactive Run&lt;/b&gt;&lt;br&gt;Step 1&lt;br&gt;&lt;br&gt;submit.py {TYPE_FLAG} [--dry-run] [--artifacts-dir]&lt;br&gt;passes NEITHER --auto-approve NOR --hold-interrupted&lt;br&gt;a hand-edited task file is a manual revision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="1010" y="170" width="210" height="155" as="geometry"/>
    </mxCell>
    <mxCell id="run-headless" value="&lt;b&gt;Headless Run&lt;/b&gt;&lt;br&gt;/rfe-speedrun Phase 3, CI&lt;br&gt;&lt;br&gt;same command plus --hold-interrupted&lt;br&gt;arms the interrupted-revision hold (5.12)&lt;br&gt;--auto-approve is the production job's, never this one" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="1010" y="355" width="210" height="155" as="geometry"/>
    </mxCell>
    <mxCell id="plan" value="&lt;b&gt;Build Submission Plan&lt;/b&gt;&lt;br&gt;scripts/submit.py&lt;br&gt;&lt;br&gt;scan_tasks over artifacts/rfe-tasks&lt;br&gt;read {ID}-review.md: recommendation, auto_revised, needs_attention&lt;br&gt;skip Archived / Submitted / no readable review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="1270" y="250" width="210" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="verify" value="&lt;b&gt;Verify Existing Items&lt;/b&gt;&lt;br&gt;&lt;br&gt;check_description_conflict vs the saved original&lt;br&gt;same GET carries the project + issuetype binding witnesses&lt;br&gt;conflict or wrong binding: skipped, left unprocessed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="1530" y="252" width="215" height="156" as="geometry"/>
    </mxCell>
    <mxCell id="jira" value="&lt;b&gt;Jira REST API&lt;/b&gt;&lt;br&gt;external&lt;br&gt;&lt;br&gt;/rest/api/3/issue, Basic Auth&lt;br&gt;jira_utils.py, NOT the Atlassian MCP server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333333;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=middle;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="1540" y="470" width="195" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="outcome" value="&lt;b&gt;Per-item&lt;br&gt;outcome?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=12;fontFamily=Inter,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
      <mxGeometry x="1795" y="265" width="195" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="disposition" value="&lt;b&gt;Per-item Disposition&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ececec;strokeColor=#333333;strokeWidth=2;container=1;collapsible=0;verticalAlign=top;spacingTop=5;fontSize=12;fontStyle=1;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="2040" y="95" width="235" height="470" as="geometry"/>
    </mxCell>
    <mxCell id="create-rename" value="&lt;b&gt;Created&lt;/b&gt;&lt;br&gt;&lt;br&gt;create_issue POST: project, issuetype, summary, description ADF, priority&lt;br&gt;rename {LOCAL_PREFIX}NNN.md to {KEY_PREFIX}NNNN.md&lt;br&gt;id field + tracker_ref = key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="disposition">
      <mxGeometry x="15" y="45" width="205" height="126" as="geometry"/>
    </mxCell>
    <mxCell id="update-item" value="&lt;b&gt;Updated&lt;/b&gt;&lt;br&gt;&lt;br&gt;update_issue PUT: summary + description ADF&lt;br&gt;removed-context comment from {ID}-removed-context.yaml&lt;br&gt;status: Submitted, post-submit hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="disposition">
      <mxGeometry x="15" y="185" width="205" height="126" as="geometry"/>
    </mxCell>
    <mxCell id="hold" value="&lt;b&gt;HELD&lt;/b&gt;&lt;br&gt;&lt;br&gt;description NOT published&lt;br&gt;review gets pass: false, error: revision_interrupted&lt;br&gt;needs-attention label only, stale verdict labels removed&lt;br&gt;left unprocessed for the next run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="disposition">
      <mxGeometry x="15" y="325" width="205" height="126" as="geometry"/>
    </mxCell>
    <mxCell id="apply-labels" value="&lt;b&gt;Apply Type Labels&lt;/b&gt;&lt;br&gt;&lt;br&gt;swap_labels PUT: one atomic add + remove&lt;br&gt;conventions.labels in types/{TYPE}/type.yaml&lt;br&gt;every label starts with {LABEL_PREFIX}-" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="2350" y="252" width="210" height="156" as="geometry"/>
    </mxCell>
    <mxCell id="report-results" value="&lt;b&gt;Step 2: Report Results&lt;/b&gt;&lt;br&gt;&lt;br&gt;created / updated / skipped per item&lt;br&gt;INDEX_ENABLED true: artifacts/rfes.md rebuilt by the script&lt;br&gt;on failure: check credentials or re-run with --dry-run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="2620" y="250" width="210" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="label-scheme" value="conventions.labels (types/{TYPE}/type.yaml)&lt;br&gt;every key renders as {LABEL_PREFIX}-...&lt;br&gt;&lt;br&gt;auto_created&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;created by the pipeline&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(new items, not updates)&lt;br&gt;auto_revised&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;review auto_revised: true&lt;br&gt;split_original&amp;nbsp;&amp;nbsp;parent that was decomposed&lt;br&gt;split_result&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;child of a split&lt;br&gt;needs_attention&amp;nbsp;review needs_attention: true&lt;br&gt;rubric_pass&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;recommendation = submit&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(excluded from auto-fix JQL)&lt;br&gt;{dimension}.{verdict}&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;one family per declared&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;dimension = {VERDICT_LABELS};&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;rfe: feasibility.feasible /&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;.infeasible / .indeterminate&lt;br&gt;&lt;br&gt;a family is mutually exclusive: each submit&lt;br&gt;adds the matching label and removes the&lt;br&gt;family's others found in original_labels;&lt;br&gt;a rejected item has its verdict labels&lt;br&gt;stripped, with none added" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;strokeWidth=1;verticalAlign=top;spacingTop=5;align=left;spacingLeft=8;fontSize=10;fontFamily=JetBrains Mono,Courier New,monospace;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="2295" y="470" width="320" height="300" as="geometry"/>
    </mxCell>
    <mxCell id="jira-fields" value="Jira field mappings (CLAUDE.md)&lt;br&gt;&lt;br&gt;RFE&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;project&amp;nbsp;&amp;nbsp;&amp;nbsp;RHAIRFE&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;issuetype Feature Request&lt;br&gt;Initiative&amp;nbsp;&amp;nbsp;project&amp;nbsp;&amp;nbsp;&amp;nbsp;RHAISTRAT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;issuetype Initiative (id 10103)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;parent&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;RHAISTRAT Outcome key&lt;br&gt;priority&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Blocker, Critical, Major,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Normal, Minor, Undefined&lt;br&gt;status on creation: New" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;strokeWidth=1;verticalAlign=top;spacingTop=5;align=left;spacingLeft=8;fontSize=10;fontFamily=JetBrains Mono,Courier New,monospace;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
