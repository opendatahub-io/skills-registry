direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/rfe.create**

  - problem statement
  - --headless
  - --priority, --labels
  - --rfe-id
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 0 ---

parse: |md
  **Step 0: Parse Args**

  - extract flags + problem text
  - --headless skips Step 2
  - remaining text = problem
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 1 ---

load-rubric: |md
  **Step 1: Load Rubric**

  - read artifacts/rfe-rubric.md
  - if missing: bootstrap
  - shapes questions + RFEs
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

assess-rfe: |md
  **assess-rfe plugin**

  - bootstrap-assess-rfe.sh
  - /export-rubric
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Decision ---

headless-q: |md
  **--headless?**

  skip clarifying Q's?
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 2 ---

clarify: |md
  **Step 2: Clarifying Questions**

  - 2-5 Q's (AskUserQuestion)
  - customers, business justification
  - user problem, size, success
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 3 (LLM) ---

generate: |md
  **Step 3: Generate RFEs**

  - WHAT/WHY, never HOW
  - one RFE per business need
  - size S/M/L/XL from AC count
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Step 4 ---

write: |md
  **Step 4: Write Artifacts**

  - next_rfe_id.py or --rfe-id
  - frontmatter.py set (Draft)
  - rebuild-index
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Output ---

result: |md
  **artifacts/rfe-tasks/RFE-NNN.md**

  - Draft + frontmatter
  - edit or /rfe.review
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Callout ---

layout-note: |md
  artifacts/
    rfe-rubric.md
    rfe-tasks/RFE-NNN.md
    rfe-reviews/
  Size Guide  S:1-2  M:3-5
              L:5-8  XL:8+
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

entry -> parse
parse -> load-rubric

load-rubric -> assess-rfe: "bootstrap" {
  style.stroke-dash: 3
}

load-rubric -> headless-q

headless-q -> clarify: "no"
headless-q -> generate: "--headless" {
  style.stroke-dash: 3
}

clarify -> generate
generate -> write
write -> result

write -> layout-note: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
