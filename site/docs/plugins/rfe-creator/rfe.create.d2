direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/rfe.create $ARGUMENTS**

  - problem statement / idea
  - --headless, --priority
  - --labels, --rfe-id
| {
  shape: rectangle
  style.stroke-width: 2
}

# --- Step 0: parse arguments ---

parse-args: |md
  **Step 0: Parse Arguments**

  - --headless (skip Q&A)
  - --priority {Blocker..Minor}
  - --labels {csv}, --rfe-id {ID}
  - rest = problem statement
| {
  shape: rectangle
  style.stroke-width: 2
}

# --- Step 1: load rubric (decision) ---

rubric-check: |md
  **Step 1: Load Rubric**

  - artifacts/rfe-rubric.md
  - exists?
| {
  shape: diamond
  style.stroke-width: 2
}

# --- Load Rubric bootstrap (container) ---

loadrubric: Load Rubric {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  bootstrap: |md
    **bootstrap-assess-rfe.sh**

    - fetch assess-rfe skills
    - .context/assess-rfe/
  |
  export-rubric: |md
    **/export-rubric**

    - assess-rfe plugin
    - write rfe-rubric.md
    - on fail: no rubric
  | {
    style.stroke-dash: 3
  }

  bootstrap -> export-rubric: "assess-rfe skills"
}

# --- Step 2: clarifying questions (LLM) ---

clarify: |md
  **Step 2: Clarifying Questions**
  LLM · AskUserQuestion

  - 2-5 Qs: customers,
    justification, problem
  - size, success outcome
  - skipped if --headless
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke-width: 3
  style.double-border: true
}

# --- Step 3: generate RFEs (LLM) ---

generate: |md
  **Step 3: Generate RFEs**
  LLM

  - WHAT / WHY only, no HOW
  - one RFE per business need
  - size from AC count
  - Jira priority value
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke-width: 3
  style.double-border: true
}

# --- Step 4: write artifacts (container) ---

write-artifacts: Step 4: Write Artifacts {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  next-id: |md
    **next_rfe_id.py {count}**

    - allocate RFE-NNN
    - atomic flock
    - or reuse --rfe-id
  |
  set-fm: |md
    **frontmatter.py set**

    - rfe_id / title / priority
    - size / status=Draft
    - schema-validated
  |
  rebuild: |md
    **frontmatter.py rebuild-index**

    - scan rfe-tasks/
    - write artifacts/rfes.md
  |

  next-id -> set-fm: "RFE-NNN ids"
  set-fm -> rebuild
}

# --- Output ---

artifacts-out: |md
  **Output**

  - artifacts/rfe-tasks/RFE-NNN.md
  - artifacts/rfes.md
  - next: /rfe.review
| {
  shape: rectangle
  style.stroke-width: 2
}

# --- Callout: Size Guide (mono) ---

size-callout: |md
  Size Guide (by AC count):
  S   1-2   Concise format
  M   3-5   Standard format
  L   5-8   Full format
  XL  8+    Full + optional
| {
  shape: rectangle
  style.font: mono
  style.font-size: 10
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
}

# --- Callout: rfe-task frontmatter (mono) ---

fm-callout: |md
  rfe-tasks/RFE-NNN.md frontmatter:
  rfe_id:   RFE-NNN or RHAIRFE-NNNN
  title:    {string}
  priority: Blocker / Critical / Major
            / Normal / Minor
  size:     S / M / L / XL
  status:   Draft
| {
  shape: rectangle
  style.font: mono
  style.font-size: 10
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
}

# --- Flow ---

entry -> parse-args
parse-args -> rubric-check
rubric-check -> clarify: "exists"
rubric-check -> loadrubric.bootstrap: "missing" {
  style.stroke-dash: 3
}
rubric-check -> generate: "--headless" {
  style.stroke-dash: 3
}
loadrubric -> clarify: "rfe-rubric.md"
clarify -> generate
generate -> write-artifacts.next-id: "RFEs drafted"
write-artifacts -> artifacts-out: "RFE-NNN.md"

# callout connectors (dashed light-grey)
generate -> size-callout: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
}
artifacts-out -> fm-callout: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
}
