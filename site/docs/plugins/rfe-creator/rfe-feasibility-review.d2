direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **rfe-feasibility-review**

  - input: one RFE ID
  - model: opus (sub-agent)
  - launched by /rfe.review
  - senior-engineer lens
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Read RFE ---

read-rfe: |md
  **Read RFE**

  - artifacts/rfe-tasks/{ID}.md
  - {ID}-comments.md
    (Jira stakeholder history)
  - prior review report (if any)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Arch context decision ---

archctx-q: |md
  **Arch context available?**

  - Read LATEST_VERSION
  - Read PLATFORM.md + docs
  - error -> RFE content alone
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Apply overlays ---

overlays: |md
  **Apply Overlays**

  - read active overlays
  - filter status/release/affects
  - overlays override
    generated docs
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Assess feasibility (LLM) ---

assess: |md
  **Assess Feasibility**
  adversarial senior-engineer review

  - buildable? barriers?
  - architectural incompatibilities?
  - technical-strategy alignment?
  - scope realistic for one feature?
  - hidden complexity / cross-team?
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Verdict decision ---

verdict-q: |md
  **Verdict**

  - feasible / infeasible
  - indeterminate
  - capability-not-yet
    != infeasible
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Result output ---

result: |md
  **{ID}-feasibility.md**

  - artifacts/rfe-reviews/
  - Feasibility verdict
  - Strategy considerations
  - Blockers + Scope assessment
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- External: architecture-context ---

archctx: |md
  **architecture-context**

  - PLATFORM.md
  - component docs
  - overlays/*.md
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Flow ---

entry -> read-rfe
read-rfe -> archctx-q
archctx-q -> overlays: "available"
archctx-q -> assess: "unavailable (RFE only)" {
  style.stroke-dash: 3
}
overlays -> assess
assess -> verdict-q
verdict-q -> result

# --- Dashed external edge ---

read-rfe -> archctx: "LATEST_VERSION / PLATFORM.md" {
  style.stroke-dash: 3
}
