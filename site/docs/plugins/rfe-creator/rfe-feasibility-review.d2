direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry: launched by /rfe.review (dashed origin) ---

entry: |md
  **Launched by /rfe.review**

  - internal sub-agent (opus)
  - user-invocable: false
  - 1 of 2N review agents
  - input: RFE {ID}
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Read RFE inputs ---

inputs: |md
  **Read RFE inputs**

  - artifacts/rfe-tasks/{ID}.md
  - {ID}-comments.md (if present)
  - = Jira stakeholder history
  - prior decisions, related work
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Architecture context (external repo, dashed) ---

arch-context: |md
  **Architecture context**
  .context/architecture-context/

  - Read LATEST_VERSION
  - architecture/{ver}/PLATFORM.md
  - relevant component docs
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

arch-check: |md
  **LATEST_VERSION readable?**
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

degrade: |md
  **Degrade gracefully**

  - Read error = file missing
  - assess on RFE content alone
  - state: context unavailable
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Overlays ---

overlays: |md
  **Apply overlays**

  - overlays/*.md status: active
  - filter release + affects
  - (platform matches all)
  - overlays take precedence
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

prior-review: |md
  **Prior review report?**
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Assess: the single LLM sub-agent reasoning step ---

assess: Assess (adversarial - find blockers) {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  reason: |md
    **Adversarial reasoning**
    LLM sub-agent (opus)

    - senior engineer lens
    - find blockers, not value
    - no implementation design
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 3
    style.double-border: true
  }
  d1-feasible: |md
    **1. Feasible?**
    technical barriers
  |
  d2-arch: |md
    **2. Arch conflict?**
    not just unbuilt
  |
  d3-strategy: |md
    **3. Strategy fit?**
    supports direction
  |
  d4-scope: |md
    **4. Scope realistic?**
    single strategy feature
  |
  d5-hidden: |md
    **5. Hidden complexity?**
    cross-component, migration,
    back-compat, multi-tenancy
  |
}

# --- Output ---

feasibility-out: |md
  **Write feasibility report**

  - mkdir rfe-reviews/
  - Write {ID}-feasibility.md
  - 4 verdict fields
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Callouts ---

report-schema: |md
  artifacts/rfe-reviews/{ID}-feasibility.md
  ### RFE-NNN: {title}
  Feasibility:
    feasible / infeasible / indeterminate
  Strategy considerations:
    none / items for /strat.refine
  Blockers:
    none / list
  Scope assessment:
    appropriate / needs splitting / unclear
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

verdicts: |md
  Feasibility verdicts
  feasible      = can build; arch
                  decisions are strategy-phase
  infeasible    = platform architecture
                  fundamentally conflicts
                  (not merely unbuilt)
  indeterminate = RFE too ambiguous to assess
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

entry -> inputs: "RFE {ID}"
inputs -> arch-context: "{ID}.md + comments"
arch-context -> arch-check
arch-check -> overlays: "found: PLATFORM.md"
arch-check -> degrade: "Read error" {
  style.stroke-dash: 3
}
overlays -> prior-review: "overlays applied"
degrade -> prior-review {
  style.stroke-dash: 3
}
prior-review -> assess: "if report: re-review"
assess -> feasibility-out: "{ID}-feasibility.md"

# Callout connectors
feasibility-out -> report-schema {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
assess -> verdicts {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
