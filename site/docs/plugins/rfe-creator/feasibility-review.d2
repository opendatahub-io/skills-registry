direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry (forked sub-agent) ---

entry: |md
  **feasibility-review**
  fork sub-agent (Opus)

  - staff-engineer reviewer
  - refined strategy features
  - Read / Grep / Glob only
  - find problems, not confirm
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Read Inputs ---

read-inputs: |md
  **Read Inputs**

  - artifacts/strat-tasks/
  - cross-ref artifacts/rfe-tasks/
    (does it deliver the RFE?)
  - prior strat-reviews/ if re-review
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Architecture Context ---

archctx: |md
  **Architecture Context**

  - .context/.../rhoai-* PLATFORM.md
  - relevant component docs
  - active overlays (status: active,
    release match, affects intersects)
  - overlays override generated docs
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Assess Feasibility (LLM) ---

assess: |md
  **Assess Feasibility**
  adversarial LLM review

  - approach works? fundamental flaws?
  - delivers what RFE asks?
    (flag silent scope cuts)
  - effort / T-shirt credible?
  - hidden deps + integration gaps
  - what's harder than it looks?
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Recommendation (decision) ---

verdict-q: |md
  **Recommendation**
  approve / revise / reject
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Result ---

result: |md
  **STRAT-NNN assessment**

  - Feasibility verdict
  - Effort estimate credibility
  - RFE alignment (gaps listed)
  - Key concerns
  - Recommendation
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- External: architecture-context repo ---

archctx-ext: |md
  **architecture-context**

  - PLATFORM.md + component docs
  - overlays (human corrections)
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Flow ---

entry -> read-inputs
read-inputs -> archctx
archctx -> assess: "grounded context"
assess -> verdict-q
verdict-q -> result: "per strategy"

# --- Dashed external edge ---

archctx -> archctx-ext: "read docs + overlays" {
  style.stroke-dash: 3
}
