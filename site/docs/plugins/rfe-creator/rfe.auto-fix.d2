direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/rfe.auto-fix**

  - explicit IDs or --jql
  - --limit, --batch-size (50)
  - --random, --reprocess
  - --headless (non-interactive)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Setup container ---

setup: Setup {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  init: |md
    **1. Init**

    - pipeline_state.py init
    - --batch-size / --headless
    - --announce-complete
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  ids: |md
    **2. Resolve IDs**

    - snapshot_fetch.py (JQL /
      --reprocess) or explicit
    - incremental fetch
    - stop if none
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  bootstrap: |md
    **3. Bootstrap**

    - bootstrap-assess-rfe.sh
    - retry once on failure
    - else stop
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  batch: |md
    **4. Resume + Batch**

    - check_resume.py
    - split into batch_size chunks
    - set total_batches
    - set-phase BATCH_START
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  init -> ids
  ids -> bootstrap
  bootstrap -> batch
}

# --- Dispatch loop hub (decision) ---

next-action: |md
  **next-action**

  - pipeline_state.py next-action
  - parse action / phase / agents
  - loop until phase DONE
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- run_script branch ---

run-phase: |md
  **run_script**

  - pipeline_state.py run-phase
  - deterministic phase step
  - phases: fetch, bootstrap,
    re-assess, split setup
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- launch_wave branch (LLM) ---

launch-wave: |md
  **launch_wave**

  - background Agent per item
  - assess / feasibility /
    review / revise / split
  - one agent per RFE
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 3
  style.double-border: true
}

# --- wait-for-wave barrier ---

wait-wave: |md
  **wait-for-wave**

  - blocking sync barrier
  - reads artifacts on disk
  - exit 0 done / exit 3 re-run
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Teardown / done ---

teardown: |md
  **Teardown (DONE)**

  - batch_summary.py
    --counts-only
  - per-phase counts
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Flow ---

entry -> setup
setup -> next-action

next-action -> run-phase: "run_script"
next-action -> launch-wave: "launch_wave"
next-action -> teardown: "done"

run-phase -> next-action: "loop" {
  style.stroke-dash: 3
}

launch-wave -> wait-wave
wait-wave -> next-action: "wave done" {
  style.stroke-dash: 3
}
wait-wave -> launch-wave: "exit 3: pending" {
  style.stroke-dash: 3
}
