direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/rfe.auto-fix {IDs} or --jql {q}**

  - --limit N, --batch-size N
  - --reprocess, --random N
  - --headless, --announce-complete
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Setup ---

setup: Setup {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  init: |md
    **1. Init**

    - pipeline_state.py init
    - --batch-size / --headless
    - --announce-complete
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  ids: |md
    **2. Resolve IDs**

    - JQL: snapshot_fetch.py fetch
    - reprocess-only snapshot
    - explicit: state.py write-ids
  | {
    shape: diamond
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  bootstrap: |md
    **3. Bootstrap**

    - bootstrap-assess-rfe.sh
    - retry once, else stop
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 2
    style.stroke-dash: 3
  }

  resume-batch: |md
    **4. Resume + Batch**

    - check_resume.py
    - split into batches of batch_size
    - set total_batches, BATCH_START
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  init -> ids
  ids -> bootstrap: "pipeline-all-ids.txt"
  bootstrap -> resume-batch
}

# --- Dispatch loop ---

dispatch: Dispatch loop (until phase=DONE) {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  next-action: |md
    **Step 1: next-action**

    - pipeline_state.py next-action
    - parse action / phase / agents
  | {
    shape: diamond
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  run-script: |md
    **run_script**

    - pipeline_state.py run-phase
    - advance phase in place
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  launch-wave: |md
    **launch_wave**
    background Agents

    - one Agent per agents[] entry
    - subagent_type + prompt_file
    - pre-rendered vars ({ID} sub'd)
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 3
    style.double-border: true
  }

  wait-for-wave: |md
    **wait-for-wave**

    - pipeline_state.py wait-for-wave
    - blocking barrier on disk
    - exit 0 continue / exit 3 re-run
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  done-step: |md
    **done**

    - phase = DONE
    - exit loop
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  next-action -> run-script: "run_script"
  next-action -> launch-wave: "launch_wave"
  next-action -> done-step: "done"
  run-script -> next-action: "phase advance" {
    style.stroke-dash: 3
  }
  launch-wave -> wait-for-wave
  wait-for-wave -> next-action: "exit 3 (pending)" {
    style.stroke-dash: 3
  }
}

# --- Teardown / output ---

teardown: |md
  **Teardown**

  - batch_summary.py --counts-only
  - --ids-file pipeline-all-ids.txt
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

output-report: |md
  **Output**

  - artifacts/rfe-reviews/*
  - run report
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Callouts ---

phases-callout: |md
  pipeline_state.py PHASES:
  BATCH_START -> FETCH -> SETUP
  -> ASSESS -> REVIEW -> REVISE
  -> FIXUP -> REASSESS_CHECK/SAVE
     /ASSESS/REVIEW/RESTORE/REVISE/FIXUP
  -> COLLECT -> SPLIT -> SPLIT_COLLECT
  -> SPLIT_PIPELINE_START
  -> SPLIT_ASSESS/REVIEW/REVISE/FIXUP
     /SAVE/REASSESS/RE_REVIEW/RESTORE
  -> SPLIT_CORRECTION_CHECK
  -> BATCH_DONE -> ERROR_COLLECT
  -> REPORT -> DONE
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

wave-callout: |md
  launch_wave (next-action YAML):
  action: launch_wave
  phase: ASSESS
  agents:
    - subagent_type: rfe-scorer
      prompt_file: {skill}/prompts/
                   assess-agent.md
      vars:
        DATA_FILE=...RHAIRFE-1234.md
        RUN_DIR=tmp/rfe-assess/single
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

entry -> setup.init
setup.resume-batch -> dispatch.next-action: "process-ids.txt"
dispatch.done-step -> teardown: "phase=DONE"
teardown -> output-report

dispatch.next-action -> phases-callout: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
dispatch.launch-wave -> wave-callout: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
