direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry (explicit-only maintenance command) ---

entry: |md
  **/rfe-creator.update-deps**

  - explicit-only invoke
    (disable-model-invocation)
  - force-refresh vendored deps
  - allowed-tools: Bash, Glob
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Column 1: assess-rfe dependency ---

assess-grp: 1. Update assess-rfe {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  remove-assess: |md
    **Remove cached**

    - rm -rf .context/assess-rfe
    - rm -rf .claude/skills/assess-rfe
    - rm -rf .claude/skills/export-rubric
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  bootstrap: |md
    **Re-fetch**
    bootstrap-assess-rfe.sh

    - git clone/pull assess-rfe
    - into .context/assess-rfe
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 2
    style.stroke-dash: 3
  }

  populate: |md
    **Repopulate**

    - cp skills to .claude/skills
    - cp agents/*.md
    - export_rubric.py to artifacts
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  remove-assess -> bootstrap
  bootstrap -> populate
}

# --- Column 2: architecture context dependency ---

arch-grp: 2. Update architecture context {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  remove-arch: |md
    **Remove cached**

    - rm -rf
      .context/architecture-context
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  fetch-arch: |md
    **Re-fetch**
    fetch-architecture-context.sh

    - detect latest rhoai-{X.Y}
    - sparse-checkout architecture
      + overlays
    - write LATEST_VERSION
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 2
    style.stroke-dash: 3
  }

  remove-arch -> fetch-arch
}

# --- Report + result ---

report: |md
  **3. Report**

  - list what was updated
  - versions fetched
    (RHOAI rhoai-{X.Y})
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

result: |md
  **Done**

  refreshed vendored deps
  + version report
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Callout: vendored dependency layout that is removed then re-fetched ---

deps-tree: |md
  vendored deps (rm -rf, then re-fetch):
  .context/assess-rfe/            git clone
  .claude/skills/assess-rfe/      cp
  .claude/skills/export-rubric/   cp
  .claude/agents/*.md             cp
  artifacts/rfe-rubric.md         export_rubric
  .context/architecture-context/  sparse-checkout
    architecture/rhoai-{X.Y}/     latest
    LATEST_VERSION
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow: two parallel columns converge on Report ---

entry -> assess-grp.remove-assess
entry -> arch-grp.remove-arch

assess-grp.populate -> report: "artifacts/rfe-rubric.md + skills"
arch-grp.fetch-arch -> report: ".context/architecture-context"

report -> result

report -> deps-tree: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
