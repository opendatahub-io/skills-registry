direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/rfe-creator.update-deps**

  - user-invocable: true
  - disable-model-invocation: true
    (slash menu only, never
    auto-delegated)
  - allowed-tools: Bash
  - $ARGUMENTS appended
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Layout check ---

layout-link: |md
  **Layout check (once)**

  - bash "{CLAUDE_SKILL_DIR}/../../../scripts/bootstrap.sh" --layout
  - skipped when the cwd is the
    plugin root (the skill dir's
    third parent)
  - links scripts/ and types/ into
    the working directory
  - any nonzero exit: stop and show
    its message (3 = the directory
    carries its own)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- The pin: a precondition, not a side effect of re-running ---

pin-decision: |md
  **Move the assess-rfe pin?**

  pipeline.rubric.ref
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

bump-pin: |md
  **Bump the pin first**

  - edit pipeline.rubric.ref in BOTH
    types/rfe/type.yaml and
    types/initiative/type.yaml
  - one shared value: python3
    scripts/validate_types.py refuses
    two different pins (cross rule 6)
  - re-running alone never moves the
    commit
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 1: remove the cached copies ---

rm-vendored: |md
  **Step 1: rm -rf the cached copies**

  - the list mirrors everything
    scripts/bootstrap.sh installs
  - .context/assess-rfe
  - .claude/skills/assess-rfe,
    assess-initiative, export-rubric
  - .claude/agents/rfe-scorer.md,
    initiative-scorer.md
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 1: re-vendor ---

bootstrap: bash scripts/bootstrap.sh {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  clone-pin: |md
    **Clone at the pinned commit**

    - git clone fullsend-ai/assess-rfe
      into .context/assess-rfe
    - fetch origin + checkout --detach
      at the descriptor-pinned ref
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 2
    style.stroke-dash: 3
  }

  verify-pin: |md
    **Verify the checkout**

    - HEAD must start with the pinned
      SHA, else ERROR exit 1
    - skills/assess-rfe/scripts/agent_prompt.md
      must exist, else ERROR exit 1
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  vendor-skills: |md
    **Vendor the skill dirs**

    - cp -r .context/assess-rfe/skills/*/
      into .claude/skills/
    - assess-rfe, assess-initiative,
      export-rubric (bundled scripts/ too)
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  copy-agents: |md
    **Copy the scorer agents**

    - cp .context/assess-rfe/agents/*.md
      into .claude/agents/
    - rfe-scorer.md, initiative-scorer.md
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  export-rubric: |md
    **Export the rubric**

    - export-rubric/scripts/export_rubric.py
      from the pinned checkout
    - writes artifacts/rfe-rubric.md
    - git info/exclude notes the
      vendored paths
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  clone-pin -> verify-pin
  verify-pin -> vendor-skills
  vendor-skills -> copy-agents
  copy-agents -> export-rubric
}

# --- Step 2: architecture context ---

rm-arch: |md
  **Step 2: drop the cached context**

  - rm -rf .context/architecture-context
  - the only path Step 2 removes
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

fetch-arch: |md
  **bash scripts/fetch-architecture-context.sh**

  - curl api.github.com .../contents/architecture,
    latest rhoai-* name wins
  - git clone --depth 1 --filter=blob:none
    --sparse opendatahub-io/architecture-context
  - sparse-checkout set architecture/{LATEST} overlays
  - writes .context/architecture-context/LATEST_VERSION
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Step 3: report ---

report-step: |md
  **Step 3: Report**

  - list what was re-vendored
  - the assess-rfe commit the bootstrap
    printed: assess-rfe at d8391ae379fb
    (types/rfe/type.yaml pipeline.rubric.ref)
  - the architecture-context version
    (LATEST_VERSION, rhoai-{x.y})
  - nothing else is written: the report
    is the reply
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Callout: the vendored-dependency tree ---

vendored-tree: |md
  Step 1 rm -rf  ->  bootstrap.sh restores

  .context/assess-rfe/                  clone, detached at the pin
  .claude/skills/assess-rfe/            cp -r skills/*/
  .claude/skills/assess-initiative/
  .claude/skills/export-rubric/
  .claude/agents/rfe-scorer.md          cp agents/*.md
  .claude/agents/initiative-scorer.md

  written by bootstrap.sh, NOT in the rm -rf list

  artifacts/rfe-rubric.md               export_rubric.py, overwritten
  .context/architecture-context/        Step 2 removes and refetches it
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Callout: the descriptor pin ---

pin-snippet: |md
  types/rfe/type.yaml

  pipeline:
    rubric:
      repo: https://github.com/fullsend-ai/assess-rfe
      ref: "d8391ae379fba0497164550e3a33495bc2007aa2"
      path: skills/assess-rfe/scripts/agent_prompt.md
      export: artifacts/rfe-rubric.md

  types/initiative/type.yaml pins the same ref
  (path: skills/assess-initiative/..., export: null)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

entry -> layout-link
layout-link -> pin-decision

pin-decision -> rm-vendored: "pin unchanged"
pin-decision -> bump-pin: "a newer assess-rfe" {
  style.stroke-dash: 3
}
bump-pin -> rm-vendored: "both descriptors agree" {
  style.stroke-dash: 3
}

rm-vendored -> bootstrap: "6 paths gone"
bootstrap -> rm-arch: "artifacts/rfe-rubric.md"

rm-arch -> fetch-arch
fetch-arch -> report-step: "LATEST_VERSION"

# --- Callout connectors ---

bootstrap -> vendored-tree: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}

pin-decision -> pin-snippet: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
