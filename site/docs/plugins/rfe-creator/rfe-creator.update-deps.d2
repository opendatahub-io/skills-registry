direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/rfe-creator.update-deps**

  - force-refresh vendored deps
  - explicit trigger only
  - disable-model-invocation
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 1 ---

update-assess: |md
  **Step 1: Update assess-rfe**

  - rm -rf .context/assess-rfe
  - rm vendored skills
    (assess-rfe, export-rubric)
  - bootstrap-assess-rfe.sh
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 2 ---

update-arch: |md
  **Step 2: Update Arch Context**

  - rm -rf
    .context/architecture-context
  - fetch-architecture-context.sh
  - detect latest RHOAI version
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 3 ---

report: |md
  **Step 3: Report**

  - list what was updated
  - versions fetched
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- External sources ---

assess-rfe-ext: |md
  **assess-rfe plugin**

  - re-fetched source
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

archctx-ext: |md
  **architecture-context**

  - re-fetched source
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Flow ---

entry -> update-assess
update-assess -> update-arch
update-arch -> report

update-assess -> assess-rfe-ext: "re-fetch" {
  style.stroke-dash: 3
}
update-arch -> archctx-ext: "re-fetch" {
  style.stroke-dash: 3
}
