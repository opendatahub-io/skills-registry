direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/rfe.speedrun**

  - {idea or Jira key}
  - --input {path}
  - --headless / --dry-run
  - --batch-size {N}
  - --announce-complete
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 0: parse + clean state ---

step0: |md
  **Step 0: Parse + Clean State**

  - state.py clean
  - prep_assess.py --clean-all
  - state.py init speedrun-config.yaml
  - batch_size defaults to 5
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

config-callout: |md
  tmp/speedrun-config.yaml

  headless: true / false
  announce_complete: true / false
  dry_run: true / false
  batch_size: 5
  input_file: {path or null}
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Mode select ---

mode-select: |md
  **Select Mode**

  - --input present? (A)
  - arg = RHAIRFE-NNNN? (B)
  - else free-text (C)
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Phase 1: Create — Mode A batch (container) ---

createA: Phase 1 - Create (Mode A: Batch) {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  validate: |md
    **Validate Batch**

    - validate_batch_input.py --strict
    - dup prompt / unknown field block
    - nonzero exit stops run
  | {
    shape: rectangle
  }
  alloc: |md
    **Pre-allocate IDs**

    - next_rfe_id.py --from-batch
    - one RFE-NNN per entry
  | {
    shape: rectangle
  }
  fanout: |md
    **Fan out N Agents**
    parallel /rfe.create

    - Agent per entry
    - /rfe.create --headless
    - --rfe-id RFE-NNN
    - exactly one RFE each
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 3
    style.double-border: true
  }

  validate -> alloc: "--strict OK"
  alloc -> fanout: "pre-alloc IDs"
}

batch-callout: |md
  --input batch.yaml (Mode A)

  - prompt: "..."        # required, unique
    priority: Critical   # optional
    labels: [candidate-3.5]
    clarifying_context: "..."
  # priority: Blocker / Critical /
  #   Major / Normal / Minor / Undefined
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Mode C: single idea (external skill) ---

modec: |md
  **Mode C: Single Idea**
  /rfe.create (external skill)

  - /rfe.create --headless {idea}
  - clarifying Qs if not headless
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Mode B: existing RFE keys ---

modeb: |md
  **Mode B: Existing RFE**

  - arg is RHAIRFE-NNNN key
  - skip create
  - keys become the list
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Persist ID list ---

persist-ids: |md
  **Persist ID List**

  - state.py write-ids
  - tmp/speedrun-all-ids.txt
  - dedup, one per line
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Phase 2: Auto-fix (external skill) + verify loop ---

autofix: |md
  **Phase 2: Auto-fix**
  /rfe.auto-fix (external skill)

  - --batch-size {N} (always pass)
  - assess, review, auto-revise
  - split oversized, retry queue
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

check: |md
  **Check Complete**

  - check_autofix_complete.py
  - every RFE reviewed?
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Phase 3: Collect + submit decision ---

collect: |md
  **Phase 3: Collect**

  - collect_recommendations.py
  - SUBMIT= / REASSESS= / ERRORS=
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

submit-ready: |md
  **Ready to Submit?**

  - any SUBMIT= ids?
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

submit-skill: |md
  **/rfe.submit**
  external skill

  - --dry-run / --headless
  - confirm table (interactive)
  - RFE-NNN renamed to RHAIRFE
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Phase 4: Summary (output) ---

summary: |md
  **Phase 4: Summary**

  - created / passed / failed / split
  - submitted RHAIRFE tickets
  - artifacts/auto-fix-runs/{ts}.yaml
  - {ts}-report.html
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Flow ---

entry -> step0
step0 -> mode-select
step0 -> config-callout: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}

mode-select -> createA.validate: "--input"
mode-select -> modec: "free-text idea"
mode-select -> modeb: "RHAIRFE-NNNN"

createA.validate -> batch-callout: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}

createA.fanout -> persist-ids: "RFE-NNN ids"
modec -> persist-ids: "RFE id"
modeb -> persist-ids: "Jira keys"

persist-ids -> autofix: "speedrun-all-ids.txt"
autofix -> check: "reviews written"
check -> collect: "COMPLETE"
check -> autofix: "MISSING_IDS (retry <= 3)" {
  style.stroke-dash: 3
}
collect -> submit-ready: "SUBMIT= line"
submit-ready -> submit-skill: "SUBMIT= ids"
submit-ready -> summary: "none ready" {
  style.stroke-dash: 3
}
submit-skill -> summary
