direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/rfe.speedrun**

  - single idea / Jira key(s)
  - --input batch.yaml
  - --headless, --dry-run
  - --batch-size, --announce-complete
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 0 ---

parse: |md
  **Step 0: Parse & Persist**

  - state.py clean + init
  - persist flags to config
  - pin batch_size (default 5)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Mode decision ---

mode-q: |md
  **Mode?**

  - A: --input batch
  - B: existing Jira key
  - C: single idea
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Validate batch (Mode A) ---

validate-batch: |md
  **Validate Batch** (Mode A)

  - validate_batch_input.py --strict
  - stop on ERROR / duplicate
  - next_rfe_id.py pre-allocate IDs
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Phase 1: Create (LLM / agents) ---

create: |md
  **Phase 1: Create**
  parallel Agents

  - one Agent per entry / single
  - each invokes /rfe.create
  - pass pre-assigned RFE-ID
  - Mode B skips this phase
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 3
  style.double-border: true
}

# --- Phase 2: Auto-fix (other skill) ---

autofix: |md
  **Phase 2: /rfe.auto-fix**

  - --batch-size passed explicitly
  - assess, review, revise
  - split oversized RFEs
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Verify decision ---

verify-q: |md
  **All processed?**

  - check_autofix_complete.py
  - MISSING_IDS → retry
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Phase 3: Submit (other skill) ---

submit-skill: |md
  **Phase 3: /rfe.submit**

  - collect_recommendations.py SUBMIT=
  - submit passing IDs
  - one confirmation gate (interactive)
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Phase 4: Summary ---

summary: |md
  **Phase 4: Summary**

  - created / review results
  - submitted / remaining issues
  - run + review reports
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Flow ---

entry -> parse
parse -> mode-q

mode-q -> validate-batch: "A: batch"
mode-q -> create: "C: single"
mode-q -> autofix: "B: existing key" {
  style.stroke-dash: 3
}

validate-batch -> create
create -> autofix
autofix -> verify-q

verify-q -> autofix: "missing IDs (retry <=3)" {
  style.stroke-dash: 3
}
verify-q -> submit-skill: "complete"
submit-skill -> summary
