direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/rfe.review**

  - RHAIRFE-NNNN ...
  - --headless
  - --caller autofix/split
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 0: parse + persist ---

parse-args: |md
  **Step 0 · Parse + Persist**

  - state.py init review-config.yaml
  - write-ids review-all-ids.txt
  - Glob artifacts/rfe-tasks/
  - never reads RFE bodies
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

split-ids: |md
  **Split IDs**

  Local vs Remote
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 1: fetch (remote) ---

fetch: |md
  **Step 1 · Fetch agents**
  opus · background

  - prompts/fetch-agent.md per ID
  - fetch_issue.py / MCP fallback
  - poll check_review_progress.py
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 3
  style.double-border: true
}

# --- Step 1.5: setup (parallel infra) ---

setup: Step 1.5 · Setup (parallel) {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  arch-context: |md
    **Architecture context**
    fetch-architecture-context.sh
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 2
    style.stroke-dash: 3
  }
  bootstrap: |md
    **Bootstrap assess-rfe**
    bootstrap-assess-rfe.sh
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 2
    style.stroke-dash: 3
  }
}

# --- Step 2: assess + feasibility wave ---

assess-wave: Assess + Feasibility wave (per ID · 2N agents) {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  assess: |md
    **Assess agent**
    rfe-scorer · opus

    - prep_assess.py
    - assess-agent.md rubric
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 3
    style.double-border: true
  }
  feasibility: |md
    **Feasibility agent**
    opus

    - rfe-feasibility-review
    - vs architecture context
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 3
    style.double-border: true
  }
}

# --- Step 3: review ---

review: |md
  **Step 3 · Review agents**
  opus · background

  - review-agent.md
  - merge assess + feasibility
  - frontmatter.py set scores
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 3
  style.double-border: true
}

# --- Step 3.5: filter + revise ---

filter-revise: |md
  **Step 3.5 · Filter**

  filter_for_revision.py
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

revise: |md
  **Revise agents**
  opus · background

  - revise-agent.md (reframe)
  - check_content_preservation.py
  - check_revised.py --batch
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 3
  style.double-border: true
}

# --- Step 4: re-assess loop ---

reassess: |md
  **Step 4 · Re-assess?**

  auto_revised & !pass
  max 2 cycles
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 5: finalize ---

finalize: |md
  **Step 5 · Finalize**

  rebuild-index
  headless?
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

output-report: |md
  **Interactive summary**

  - batch_summary.py
  - {ID}-review.md
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

caller-return: |md
  **Resume caller**
  /rfe.auto-fix Step 3b
  /rfe.split Step 3
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Callout: rfe-review frontmatter ---

review-fm: |md
  rfe-reviews/{ID}-review.md
  ---
  rfe_id: {ID}
  score: {int}   pass: {bool}
  recommendation: submit / revise /
    split / reject / autorevise_reject
  feasibility: feasible / infeasible /
    indeterminate
  auto_revised: {bool}
  needs_attention: {bool}
  scores:
    what / why / open_to_how /
    not_a_task / right_sized  (0-2)
  before_score / before_scores
  ---
  ## Assessor Feedback
  ## Technical Feasibility
  ## Strategy Considerations
  ## Revision History
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Callout: artifacts/ tree ---

artifacts-tree: |md
  artifacts/
    rfes.md            (index, rebuilt)
    rfe-tasks/
      {ID}.md          (frontmatter)
      {ID}-comments.md
      {ID}-removed-context.yaml
    rfe-originals/
      {ID}.md          (baseline)
    rfe-reviews/
      {ID}-review.md
      {ID}-feasibility.md
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

entry -> parse-args
parse-args -> split-ids
parse-args -> setup: "parallel setup"

split-ids -> fetch: "Remote"
split-ids -> assess-wave: "Local: {ID}.md exists"

fetch -> assess-wave: "{ID}.md"
setup -> assess-wave: ".context/ rubric + arch"

assess-wave -> review: "result.md + feasibility.md"

review -> filter-revise: "{ID}-review.md"
filter-revise -> revise: "needs revision"
filter-revise -> finalize: "none to revise" {
  style.stroke-dash: 3
}

revise -> reassess: "auto_revised"
reassess -> assess-wave: "re-assess cycle\n(poll NEXT_POLL)" {
  style.stroke-dash: 3
}
reassess -> finalize: "pass / max cycles"

finalize -> output-report: "interactive"
finalize -> caller-return: "--headless" {
  style.stroke-dash: 3
}

review -> review-fm: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}

split-ids -> artifacts-tree: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
