direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/rfe.review**

  - RHAIRFE-NNN / RFE-NNN IDs
  - --headless
  - --caller <autofix|split>
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 0: Parse & Persist ---

parse: |md
  **Step 0: Parse & Persist**

  - strip --headless / --caller
  - state.py: flags + IDs to disk
  - classify local vs remote (Glob)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 1: Fetch Missing RFEs (LLM) ---

fetch: |md
  **Step 1: Fetch Missing RFEs**
  parallel fetch agents (Opus)

  - one agent per remote ID
  - check_review_progress.py poll
  - write task files to disk
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Step 1.5: Setup ---

setup: |md
  **Step 1.5: Setup**
  parallel, non-fatal

  - fetch-architecture-context.sh
  - bootstrap-assess-rfe.sh
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 2: Evaluate (container, 2N agents) ---

evaluate: "Step 2: Evaluate (2N agents)" {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  feasibility: |md
    **Feasibility Review**
    rfe-feasibility-review agent

    - technical fork
    - verdict: feasible /
      infeasible / indeterminate
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 2
    style.double-border: true
  }

  assess: |md
    **Rubric Assessment**
    rfe-scorer agent

    - prep_assess.py
    - score what / why / how
    - not-a-task / right-sized
  | {
    shape: rectangle
    style.fill: "#e8e8e8"
    style.stroke: "#333333"
    style.stroke-width: 2
    style.double-border: true
  }
}

# --- Step 3: Review Agents (LLM) ---

review: |md
  **Step 3: Review Agents**

  - combine assess + feasibility
  - scored review file
  - pass / fail, recommendation
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Decision ---

pass-q: |md
  **All pass?**
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Step 3.5: Auto-Revise (LLM) ---

revise: |md
  **Step 3.5: Auto-Revise**

  - filter_for_revision.py
  - revise failing RFEs
  - check_revised.py --batch
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Step 4: Re-assess Cycle (LLM) ---

reassess: |md
  **Step 4: Re-assess Cycle**
  max 2 cycles

  - save / restore state
  - re-run assess + review
  - re-run revise
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Step 5: Finalize (container) ---

finalize: "Step 5: Finalize" {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  headless: |md
    **Headless Return**

    - rebuild index
    - return to caller
      (auto-fix / split)
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  interactive: |md
    **Interactive Summary**

    - batch_summary.py
    - suggest next steps
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }
}

# --- External services ---

jira: |md
  **Jira (RHAIRFE)**

  - REST API / MCP
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

archctx: |md
  **architecture-context**

  - RHOAI version + docs
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

assess-rfe: |md
  **assess-rfe plugin**

  - rubric reference
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Callout: review frontmatter ---

review-fm: |md
  artifacts/rfe-reviews/{ID}-review.md
  ---
  rfe_id: RHAIRFE-NNN
  score: 0-100
  pass: true | false
  recommendation:
    accept | revise | split
  feasibility:
    feasible | infeasible
  auto_revised: true | false
  scores.what / why / open_to_how
  scores.not_a_task / right_sized
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

entry -> parse
parse -> fetch: "remote IDs"
parse -> setup: "local (skip fetch)"
fetch -> setup
setup -> evaluate
evaluate -> review: "assess + feasibility"
review -> pass-q
pass-q -> revise: "failing"
pass-q -> finalize: "all pass" {
  style.stroke-dash: 3
}
revise -> reassess
reassess -> evaluate: "revised, still failing" {
  style.stroke-dash: 3
}
reassess -> finalize: "pass or max cycles"

# --- Dashed external / callout edges ---

fetch -> jira: "REST / MCP" {
  style.stroke-dash: 3
}
setup -> archctx {
  style.stroke-dash: 3
}
evaluate.assess -> assess-rfe: "rubric" {
  style.stroke-dash: 3
}
review -> review-fm {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
