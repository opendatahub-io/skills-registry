direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Setup (optional) ---

eval-setup: |md
  **/eval-setup**

  - env + credentials
  - MLflow config
  - verify harness deps
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Analyze (LLM) ---

eval-analyze: |md
  **/eval-analyze**

  - deep-read target skill
  - infer I/O + judges
  - emit eval.yaml
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Dataset (LLM) ---

eval-dataset: |md
  **/eval-dataset**

  - generate test cases
  - inputs + expectations
  - cover edge cases
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Run (LLM, central hub) ---

eval-run: |md
  **/eval-run**

  - headless execution
  - score with LLM judges
  - HTML report + summary.yaml
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Fan-out targets ---

eval-optimize: |md
  **/eval-optimize**

  - automated fix loop
  - edit skill + re-run
  - until judges pass
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

eval-review: |md
  **/eval-review**

  - human-in-the-loop
  - walk per-case results
  - collect feedback.yaml
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

eval-mlflow: |md
  **/eval-mlflow**

  - sync dataset
  - log results + traces
  - push / pull feedback
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

eval-compare: |md
  **/eval-compare**

  - diff multiple runs
  - tabbed HTML comparison
  - regressions vs baseline
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Anova (processing orchestrator) ---

eval-anova: |md
  **/eval-anova**

  - DoE factor matrix
  - fan out /eval-run
  - ANOVA effects
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Check (standalone) ---

eval-check: |md
  **/eval-check**

  - full-harness health check
  - deps, MLflow, perms
  - standalone diagnostic
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Callout: shared eval.yaml schema ---

eval-yaml: |md
  eval.yaml
  name / description
  execution: {mode: case|batch,
    skill, arguments}
  runner: {type: claude-code, effort}
  models: {skill, judge}
  permissions: {allow, deny}
  dataset: {path, schema}
  outputs: [{path, schema}]
  mlflow: {experiment, tracking_uri}
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

eval-setup -> eval-analyze: "optional" {
  style.stroke-dash: 3
}
eval-analyze -> eval-dataset: "eval.yaml"
eval-dataset -> eval-run: "test cases"

# eval-run fan-out (central hub)
eval-run -> eval-optimize: "summary.yaml"
eval-run -> eval-review: "summary.yaml"
eval-run -> eval-mlflow: "log results + traces"
eval-run -> eval-compare: "runs"

# optimize back-edge
eval-optimize -> eval-run: "re-run until judges pass" {
  style.stroke-dash: 3
}

# anova orchestrator
eval-anova -> eval-run: "fan out /eval-run"
eval-anova -> eval-compare: "anova.json"

# callout connector
eval-analyze -> eval-yaml: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
