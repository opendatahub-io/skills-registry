direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/eval-check**

  - --output <path>
    (default harness-report.md)
  - --include-global
    (opt-in ~/.claude)
  - read-only health check
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Inventory ---

inventory: |md
  **Inventory**
  harness_inventory.py --root .

  - discover skills / commands
  - CLAUDE.md, settings hooks
  - word count per skill
  - structural warnings
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Decision: single-skill project? ---

single: |md
  **Single-skill
  project?**
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Read components ---

read-config: |md
  **Read Components**

  - each SKILL.md frontmatter + body
  - project CLAUDE.md(s)
  - opt-in ~/.claude global
  - cross-skill references
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Analyze as one system (LLM agent) ---

analyze: |md
  **Analyze as One System**
  LLM agent

  - compare every skill pair
  - rules vs CLAUDE.md
  - qualitative overlap
  - not deterministic
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 3
  style.double-border: true
}

# --- Classify findings ---

filter-classify: |md
  **Classify Findings**

  - content overlap
  - trigger overlap
  - CLAUDE.md duplication
  - type misclassification
  - structural issues
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Write report ---

report: |md
  **Write Report**

  - harness-report.md
  - findings + suggestions
  - refuses paths outside root
  - only the report is written
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Present summary ---

summary: |md
  **Present Summary**

  - counts per category
  - top 3 suggestions
  - next: /eval-analyze
  - next: /eval-run
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Callout: harness inventory (primary intermediate) ---

inventory-json: |md
  harness inventory (--format yaml)
  summary:  {skills, commands,
             hooks, claude_md,
             total_word_count}
  skills:   [{name, path,
              words, description}]
  commands: [{name, path, words}]
  claude_md:{path, words, lines}
  hooks:    [{type, matcher,
              command}]
  warnings: [...]
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Callout: primary output artifact ---

report-md: |md
  harness-report.md
  # Harness Health Report
  ## Inventory (skills/cmds/hooks)
  ### Skills by size (table)
  ## Findings   (5 categories)
    - Content Overlap
    - Trigger Overlap
    - CLAUDE.md Duplication
    - Type Misclassification
    - Structural Issues
  ## Suggestions (numbered)
  ## Notes
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

entry -> inventory
inventory -> single: "inventory (skills,\ncmds, CLAUDE.md, hooks)"
single -> read-config: "multiple skills"
read-config -> analyze
analyze -> filter-classify: "raw findings"
filter-classify -> report: "5 categories"
report -> summary: "harness-report.md"

# --- Single-skill short-circuit (dashed) ---

single -> report: "single skill\n(skip analysis)" {
  style.stroke-dash: 3
}

# --- Callout connectors ---

inventory -> inventory-json: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}

report -> report-md: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
