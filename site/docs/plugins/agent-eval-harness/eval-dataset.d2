direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/eval-dataset**

  - --config {path}
  - --count N (default 5)
  - --run-id (learn from run)
  - --harbor / --image
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Read context + parse schema ---

read-context: |md
  **Read Context & Schema**

  - eval.yaml + eval.md
  - judge-driven requirements
  - parse dataset.schema
  - {field} placeholders in args
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Provenance decision (generation.strategy) ---

strategy: |md
  **generation.strategy?**

  case provenance
  skill (default) · synthetic
  · from-traces
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Branches ---

mlflow-traces: |md
  **MLflow Traces**
  from_traces.py (external)

  - search production traces
  - extract real inputs
  - prompt + tool calls
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

synthetic-gen: |md
  **Synthetic Generation**
  generate_synthetic.py (LLM)

  - resolve seeds: builtin/file/inline
  - Claude API per seed.count
  - write input.yaml + annotations.yaml
  - stamp annotations.category
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Fresh vs augment (derived from dataset state, Step 3) ---

dataset-state: |md
  **dataset state?**

  Step 3 assessment
  empty/thin -> fresh
  populated -> augment
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

gap-analysis: |md
  **Gap Analysis**
  LLM augment

  - read existing cases
  - judges w/ no covering case
  - target --run-id failures
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

case-generation: |md
  **Case Generation**
  LLM author (converge)

  - bootstrap simple/complex/edge
  - + judge-targeted cases
  - shape trace inputs to schema
  - realistic, not templated
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- External-state fields ---

external-fields: |md
  **External-State Fields**

  - [EXTERNAL: System] fields
  - TODO_ placeholder values
  - never fabricate Jira keys,
    repos, API endpoints
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Write cases ---

write-cases: |md
  **Write Test Cases**

  - case-NNN-slug/ dirs
  - input.yaml (+ {field} args)
  - answers.yaml (interactive)
  - annotations.yaml (judges)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Validate + report ---

report: |md
  **Validate & Report**

  - re-read case vs schema
  - both if-branches covered
  - list TODO_ placeholders
  - --harbor: task packages
  - next: /eval-run
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Callout: case directory tree (primary artifact) ---

case-tree: |md
  eval/dataset/cases/
    case-001-slug/
      input.yaml       # prompt + context, {field}
      answers.yaml     # interactive Q&A answers
      annotations.yaml # per-judge expectations
      reference.md     # gold-standard output
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

entry -> read-context
read-context -> strategy: "eval.yaml + eval.md"

# Three provenance strategies (generation.strategy)
strategy -> mlflow-traces: "from-traces" {
  style.stroke-dash: 3
}
strategy -> dataset-state: "skill (default)"
strategy -> synthetic-gen: "synthetic"

# from-traces rejoins the agent-authored fresh/augment assessment
mlflow-traces -> dataset-state: "real inputs" {
  style.stroke-dash: 3
}

# Fresh vs augment — derived from dataset state (Step 3), a separate axis
dataset-state -> case-generation: "fresh (empty/thin)"
dataset-state -> gap-analysis: "augment (populated)"
gap-analysis -> case-generation: "gap-filling cases"

# Agent-authored write path
case-generation -> external-fields
external-fields -> write-cases: "input.yaml + annotations.yaml"
write-cases -> report: "case-NNN/"

# Synthetic path writes cases directly, joins at validate/report
synthetic-gen -> report: "case-NNN/ + annotations.yaml"

# Callout connector
write-cases -> case-tree: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
