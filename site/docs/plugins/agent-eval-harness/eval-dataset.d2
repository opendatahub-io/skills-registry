direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/eval-dataset**

  - --config <path>
  - --count N (default 5)
  - --run-id (learn from run)
  - --harbor / --image
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Read context + assess ---

read-context: |md
  **Read Context & Assess**

  - eval.yaml + eval.md
  - judge-driven requirements
  - parse dataset.schema
  - assess existing cases (fresh?)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Provenance decision ---

strategy: |md
  **generation.strategy?**

  case provenance
  skill · from-traces
  synthetic (script)
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Branches ---

mlflow-traces: |md
  **MLflow Traces**
  from_traces.py (external)

  - search production traces
  - extract real inputs
  - prompt + tool calls
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

gap-analysis: |md
  **Gap Analysis**
  LLM augment

  - read existing cases
  - judges w/ no covering case
  - target --run-id failures
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

case-generation: |md
  **Case Generation**
  LLM author (converge)

  - bootstrap simple/complex/edge
  - + judge-targeted cases
  - shape trace inputs to schema
  - realistic, not templated
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- External-state fields ---

external-fields: |md
  **External-State Fields**

  - [EXTERNAL: System] fields
  - TODO_ placeholder values
  - never fabricate Jira keys,
    repos, API endpoints
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Write cases ---

write-cases: |md
  **Write Test Cases**

  - case-NNN-slug/ dirs
  - input.yaml (+ {field} args)
  - answers.yaml (interactive)
  - annotations.yaml (judges)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Validate + report ---

report: |md
  **Validate & Report**

  - re-read case vs schema
  - both if-branches covered
  - list TODO_ placeholders
  - --harbor: task packages
  - next: /eval-run
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Callout: case directory tree (primary artifact) ---

case-tree: |md
  eval/dataset/cases/
    case-001-slug/
      input.yaml       # prompt + context, {field}
      answers.yaml     # interactive Q&A answers
      annotations.yaml # per-judge expectations
      reference.md     # gold-standard output
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

entry -> read-context
read-context -> strategy: "eval.yaml + eval.md"

strategy -> mlflow-traces: "from-traces" {
  style.stroke-dash: 3
}
strategy -> case-generation: "bootstrap (fresh)" {
  style.stroke-dash: 3
}
strategy -> gap-analysis: "expand (augment)" {
  style.stroke-dash: 3
}

mlflow-traces -> case-generation: "real inputs" {
  style.stroke-dash: 3
}
gap-analysis -> case-generation: "gap-filling cases"

case-generation -> external-fields
external-fields -> write-cases: "input.yaml + annotations.yaml"
write-cases -> report: "case-NNN/"

write-cases -> case-tree: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
