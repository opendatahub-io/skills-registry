direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/eval-analyze**

  - --skill <name>
  - --prompt <path>
  - --config <path>
  - --update / --assess
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Discover ---

find-skills: |md
  **Discover Target & Layout**

  - state.py init tmp/
  - discover.py (config path)
  - find_skills.py --name
  - reads plugin.json paths
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Mode decision ---

mode-q: |md
  **Analysis mode?**
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Skill mode: deep read (LLM) ---

explore: |md
  **Deep-Read Skill**
  _LLM sub-agent (Explore)_

  - follow sub-skill chains
  - read scripts + sample cases
  - observe, don't assume
  - infer purpose, I/O, judges
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Prompt mode: resolve recipe ---

resolve-prompt: |md
  **Resolve Prompt**

  - resolve_prompt.py
  - load analysis recipe
  - custom eval criteria
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Generate config (LLM) ---

gen-yaml: |md
  **Generate eval.yaml**
  _LLM synthesis_

  - eval-yaml-template.md
  - execution mode + schema
  - outputs, judges, models
  - thresholds, permissions
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Validate ---

validate: |md
  **Validate Config**

  - validate_eval.py config
  - paths resolve + relative
  - judge / module refs
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Valid decision ---

valid-q: |md
  **Valid?**
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Cache analysis ---

eval-md: |md
  **Cache eval.md**

  - skill_hash (sha256)
  - analyzed_at + narrative
  - staleness check
  - next: /eval-dataset, /eval-run
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Callout: primary output artifact ---

eval-yaml-callout: |md
  eval.yaml
  name / description
  execution: {mode: case|batch,
    skill, arguments}
  runner: {type: claude-code, effort}
  models: {skill, judge}
  permissions: {allow: [],
    deny: [mcp__*]}
  dataset: {path, schema}
  outputs: [{path, schema}]
  mlflow: {experiment}
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

entry -> find-skills
find-skills -> mode-q

mode-q -> explore: "--skill"
mode-q -> resolve-prompt: "--prompt"
resolve-prompt -> explore: "prompt content"

explore -> gen-yaml
gen-yaml -> validate: "eval.yaml"
validate -> valid-q

valid-q -> eval-md: "valid"
valid-q -> gen-yaml: "errors -> fix" {
  style.stroke-dash: 3
}

# --- Callout connector ---

gen-yaml -> eval-yaml-callout: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
