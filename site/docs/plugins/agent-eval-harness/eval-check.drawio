    <mxCell id="summary" value="&lt;b&gt;Present Summary&lt;/b&gt;&lt;br&gt;&lt;br&gt;counts per category&lt;br&gt;top 3 suggestions&lt;br&gt;next: /eval-analyze&lt;br&gt;next: /eval-run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="415" y="500" width="205" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="report-md" value="harness-report.md&lt;br&gt;# Harness Health Report&lt;br&gt;## Inventory (skills/cmds/hooks)&lt;br&gt;### Skills by size (table)&lt;br&gt;## Findings   (5 categories)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Content Overlap&lt;br&gt;&amp;nbsp;&amp;nbsp;- Trigger Overlap&lt;br&gt;&amp;nbsp;&amp;nbsp;- CLAUDE.md Duplication&lt;br&gt;&amp;nbsp;&amp;nbsp;- Type Misclassification&lt;br&gt;&amp;nbsp;&amp;nbsp;- Structural Issues&lt;br&gt;## Suggestions (numbered)&lt;br&gt;## Notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;strokeWidth=1;verticalAlign=top;spacingTop=5;align=left;spacingLeft=8;fontSize=10;fontFamily=JetBrains Mono,Courier New,monospace;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
