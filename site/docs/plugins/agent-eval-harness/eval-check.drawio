<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="inventory-json" value="harness inventory (--format yaml)&lt;br&gt;summary:  {skills, commands,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;hooks, claude_md,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;total_word_count}&lt;br&gt;skills:   [{name, path,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;words, description}]&lt;br&gt;commands: [{name, path, words}]&lt;br&gt;claude_md:{path, words, lines}&lt;br&gt;hooks:    [{type, matcher, command}]&lt;br&gt;warnings: [...]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;strokeWidth=1;verticalAlign=top;spacingTop=5;align=left;spacingLeft=8;fontSize=10;fontFamily=JetBrains Mono,Courier New,monospace;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="300" y="40" width="280" height="185" as="geometry"/>
    </mxCell>
    <mxCell id="entry" value="&lt;b&gt;/eval-check&lt;/b&gt;&lt;br&gt;&lt;br&gt;--output {path}&lt;br&gt;(default harness-report.md)&lt;br&gt;--include-global (opt-in ~/.claude)&lt;br&gt;read-only health check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="275" width="195" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="inventory" value="&lt;b&gt;Inventory&lt;/b&gt;&lt;br&gt;harness_inventory.py --root .&lt;br&gt;&lt;br&gt;discover skills / commands&lt;br&gt;CLAUDE.md, settings hooks&lt;br&gt;word count per skill&lt;br&gt;structural warnings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="305" y="275" width="200" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="single" value="&lt;b&gt;Single-skill project?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;fontSize=12;fontFamily=Inter,Helvetica,Arial,sans-serif;" vertex="1" parent="1">
      <mxGeometry x="575" y="302" width="150" height="96" as="geometry"/>
    </mxCell>
    <mxCell id="read-config" value="&lt;b&gt;Read Components&lt;/b&gt;&lt;br&gt;&lt;br&gt;each SKILL.md frontmatter + body&lt;br&gt;project CLAUDE.md(s)&lt;br&gt;opt-in ~/.claude global&lt;br&gt;cross-skill references" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="775" y="275" width="210" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="analyze" value="&lt;b&gt;Analyze as One System&lt;/b&gt;&lt;br&gt;LLM agent&lt;br&gt;&lt;br&gt;compare every skill pair&lt;br&gt;rules vs CLAUDE.md&lt;br&gt;qualitative overlap&lt;br&gt;not deterministic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333333;strokeWidth=3;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;double=1;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="1055" y="275" width="205" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="filter-classify" value="&lt;b&gt;Classify Findings&lt;/b&gt;&lt;br&gt;&lt;br&gt;content overlap&lt;br&gt;trigger overlap&lt;br&gt;CLAUDE.md duplication&lt;br&gt;type misclassification&lt;br&gt;structural issues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="1055" y="495" width="205" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="report" value="&lt;b&gt;Write Report&lt;/b&gt;&lt;br&gt;&lt;br&gt;harness-report.md&lt;br&gt;findings + suggestions&lt;br&gt;refuses paths outside root&lt;br&gt;only the report is written" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=2;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="1">
      <mxGeometry x="735" y="500" width="210" height="150" as="geometry"/>
