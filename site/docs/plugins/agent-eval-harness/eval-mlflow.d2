direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/eval-mlflow**

  - --action: sync-dataset,
    log-results, push-feedback,
    pull-feedback, all
  - --config eval.yaml (auto)
  - --run-id (log / push / pull)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Resolve tracking URI ---

resolve: |md
  **Resolve Tracking URI**

  - ensure_server() reachable?
  - eval.yaml mlflow.tracking_uri
  - MLFLOW_TRACKING_URI env
  - default http://127.0.0.1:5000
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Graceful degradation (fallback) ---

degrade: |md
  **Graceful Degradation**

  - MLflow unreachable
  - scripts exit 0 (no fail)
  - report "not available,
    skipping"
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Action dispatch (decision) ---

action: |md
  **--action?**
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Sync dataset ---

sync: |md
  **Sync Dataset**
  sync_dataset.py (two-phase)

  - interpret dataset.schema +
    sample case
  - schema_mapping.json:
    inputs vs expectations
  - preview then merge_records
  - deduplicates
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Log results ---

log: |md
  **Log Results**
  log_results.py --run-id

  - params / metrics / artifacts
  - per-case results table
  - traces built from stdout.log
  - tags regressions / judges
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Push feedback ---

push-fb: |md
  **Push Feedback**
  attach_feedback.py --source all

  - judge scores to CODE
    (case/judge) from summary.yaml
  - human review to HUMAN
    (case/human_review) review.yaml
  - skips if no traces
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Pull feedback ---

pull-fb: |md
  **Pull Feedback**
  attach_feedback.py --action pull

  - read MLflow UI annotations
  - write review.yaml
    mlflow_feedback
  - consumed by /eval-optimize
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- MLflow server (external) ---

mlflow: |md
  **MLflow Server**
  external service

  - experiment tracking
  - dataset registry
  - execution traces
  - feedback / assessments
    ($MLFLOW_TRACKING_URI)
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Report ---

report: |md
  **Report & Next Steps**

  - N cases synced / run logged
  - N feedback pushed / N pulled
  - MLflow UI link
  - next: /eval-review, /eval-optimize
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Callout: MLflow run structure (log_results.py) ---

run-callout: |md
  MLflow run (log_results.py)
  params:  skill, eval_name, runner,
           run_id, model
  metrics: {judge}/pass_rate,
           {judge}/mean, cost_usd,
           duration_s, num_turns
  tags:    regressions_detected,
           num_judges, +mlflow.tags
  artifacts: summary.yaml, inputs/,
           per_case_results.json
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Callout: schema_mapping.json (sync_dataset.py) ---

mapping-callout: |md
  tmp/schema_mapping.json
    inputs:
      prompt: input.yaml:prompt
    expectations:
      ref: reference.md:__file__
    (filename:field_path
     or filename:__file__)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

entry -> resolve
resolve -> degrade: "unreachable" {
  style.stroke-dash: 3
}
degrade -> report: "skipped (exit 0)" {
  style.stroke-dash: 3
}
resolve -> action: "server OK"

action -> sync: "sync-dataset | all"
action -> log: "log-results | all"
action -> push-fb: "push-feedback | all"
action -> pull-fb: "pull-feedback"

sync -> mlflow: "dataset records"
log -> mlflow: "summary.yaml + traces"
push-fb -> mlflow: "CODE + HUMAN feedback"
mlflow -> pull-fb: "annotations -> review.yaml" {
  style.stroke-dash: 3
}

mlflow -> report: "results + UI link"

# --- Callout connectors ---

log -> run-callout: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
sync -> mapping-callout: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
