direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/eval-setup**

  - --tracking-uri {uri}
  - --skip-mlflow
  - --runs-dir {path}
  - --harbor
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Preflight ---

preflight: |md
  **Preflight Checks**
  check_env.py --fix

  - python>=3.11, mlflow, pyyaml
  - agent_eval symlink
  - anthropic SDK (optional)
  - create runs/ + tmp/
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Decision ---

decision: |md
  **All checks pass?**
  deps / API key / MLflow
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Install deps (fallback) ---

install-deps: |md
  **Install Deps**
  ensure_deps.py (fallback)

  - isolated .eval-venv/
  - uv pip / venv pip
  - mlflow[genai], anthropic[vertex]
  - --harbor: harbor + kubernetes
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- External: MLflow server ---

mlflow-server: |md
  **MLflow Server**
  external

  - local server :5000
  - or remote / Databricks
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Configure Environment (container) ---

configure: Configure Environment {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  mlflow-config: |md
    **MLflow Tracking**

    - local server / file store
      (sqlite) / remote
    - set MLFLOW_TRACKING_URI
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  verify-keys: |md
    **API Keys**

    - ANTHROPIC_API_KEY
    - or ANTHROPIC_VERTEX_PROJECT_ID
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  runs-exp: |md
    **Runs + Experiment**

    - $AGENT_EVAL_RUNS_DIR
    - create runs dir
    - setup_experiment(eval.yaml)
  | {
    shape: rectangle
    style.fill: "#f5f5f5"
    style.stroke: "#333333"
    style.stroke-width: 2
  }

  mlflow-config -> verify-keys
  verify-keys -> runs-exp
}

# --- Re-verify ---

reverify: |md
  **Re-verify**
  check_env.py

  - confirm all checks pass
  - validate eval.yaml
  - detect CLAUDE.md / AGENTS.md
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Environment Ready ---

ready: |md
  **Environment Ready**

  - report status
  - next: /eval-analyze
  - dataset -> run
  - review / optimize
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Callout: environment the setup produces ---

env-callout: |md
  Environment (check_env.py)
  deps: python>=3.11, mlflow,
        pyyaml, agent_eval(symlink)
  ANTHROPIC_API_KEY
    (or ANTHROPIC_VERTEX_PROJECT_ID)
  MLFLOW_TRACKING_URI
    (http://127.0.0.1:5000)
  AGENT_EVAL_RUNS_DIR (runs/)
  .eval-venv/  (uv pip install ...)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

entry -> preflight
preflight -> decision: "check_env.py --fix"

decision -> install-deps: "fix / configure"
install-deps -> configure: "venv ready"

configure -> reverify: "eval.yaml"
reverify -> ready

# --- All-clear fast path: SKILL.md Step 2 "skip to Step 6" (setup_experiment) ---

decision -> configure.runs-exp: "all pass -> Step 6" {
  style.stroke-dash: 3
}

# --- External MLflow server feeds config ---

mlflow-server -> configure: "MLFLOW_TRACKING_URI" {
  style.stroke-dash: 3
}

# --- Callout connector ---

reverify -> env-callout: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
