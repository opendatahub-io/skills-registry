direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/eval-run**

  - --model / --baseline
  - --cases / --run-id
  - --no-llm-judges
  - --runner local | harbor
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Preflight ---

preflight: |md
  **Preflight Check**
  preflight.py

  - scan tmp/ + runs dir
  - stale artifacts?
  - CLEAN | DIRTY | MISSING_BASELINE
  - --clean --force
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Workspace ---

workspace: |md
  **Prepare Workspace**
  workspace.py

  - isolated per-case dirs
  - batch.yaml + symlinks
  - .claude/settings.json + hooks
  - git init (diff baseline)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Mode decision ---

mode: |md
  **Case or Batch?**
  execution.mode
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Execute (agent) ---

execute: |md
  **Execute**
  execute.py (EvalRunner)

  - headless run per case
  - skill | prompt mode
  - lifecycle hooks (before/after)
  - poll console.log, run_result.json
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Skill under test (external) ---

skill-under-test: |md
  **Skill under test**
  invoked headlessly

  - claude --print
  - writes to project dir
  - stdout.log + artifacts
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.stroke-dash: 3
}

# --- Collect ---

collect: |md
  **Collect Artifacts**
  collect.py

  - map outputs to cases
  - per-case dirs + _modified
  - events.json from stdout
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Scoring container ---

scoring: Score (score.py) {
  style.fill: "#ececec"
  style.stroke: "#333333"
  style.stroke-width: 2

  builtin: |md
    **Builtin Judges**

    - harness library
    - deterministic
  |
  checks: |md
    **Inline Checks**

    - Python check snippets
    - external module/function
  |
  llm-judge: |md
    **LLM Judge**
    prompt / prompt_file

    - Jinja2 rubric
    - submit_evaluation tool
  | {
    style.fill: "#e8e8e8"
    style.double-border: true
  }
  pairwise: |md
    **Pairwise Judge**
    vs --baseline

    - position-swapped A/B
    - regression thresholds
  | {
    style.fill: "#e8e8e8"
    style.double-border: true
  }
}

# --- Report ---

report: |md
  **HTML Report**
  report.py

  - summary.yaml (by score.py)
  - report.html side-by-side diffs
  - per-case details
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Analyze (agent) ---

analyze: |md
  **Analyze Results**
  analyze-results.md

  - decisive Recommendation
  - analysis.md (frontmatter)
  - suggest next steps
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 2
  style.double-border: true
}

# --- Preflight abort (MISSING_BASELINE) ---

abort: |md
  **Abort: baseline missing**
  exit 2

  - runs/{eval}/{baseline} absent
  - lists nearby run-ids
  - confirm --baseline, retry
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Callouts ---

summary-yaml: |md
  runs/{eval}/{run-id}/summary.yaml
  run_id: 2026-07-31-opus
  judges:              # per-judge aggregate
    {name}:
      mean / pass_rate
      stability: {...}   # if samples>1
  per_case:            # value + rationale
    case-001-slug:
      {gate}:  {value: true, rationale}
      {score}: {value: 4,    rationale}
  run_metrics:         # cost_per_turn_usd,
                       # cache_hit_rate
  pairwise:            # only if --baseline
    wins_a / wins_b / ties
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

run-tree: |md
  runs/{eval}/{run-id}/
    summary.yaml     <- judges + per_case
    report.html      <- report.py
    collection.json  <- collect.py counts
    run_result.json  <- exit_code, cost_usd
    analysis.md      <- recommendation
    cases/
      case-001-slug/
        {output dirs}/
        events.json
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

entry -> preflight
preflight -> workspace: "CLEAN"
preflight -> preflight: "DIRTY: --clean --force" {
  style.stroke-dash: 3
}
preflight -> abort: "MISSING_BASELINE (exit 2)" {
  style.stroke-dash: 3
}
workspace -> mode: "N cases"

mode -> execute: "case (default)"
mode -> execute: "batch: batch.yaml"

execute -> skill-under-test: "invoke headless"
skill-under-test -> execute: "stdout + artifacts" {
  style.stroke-dash: 3
}

execute -> collect: "workspace outputs"
collect -> scoring: "collection.json"
scoring -> report: "summary.yaml"
report -> analyze

analyze -> entry: "/eval-optimize iterates" {
  style.stroke-dash: 3
}

# --- Callout connectors ---

report -> summary-yaml: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
collect -> run-tree: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
