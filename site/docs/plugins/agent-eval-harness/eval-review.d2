direction: right

*.style.border-radius: 8
*.style.font-size: 13
*.style.fill: "#f5f5f5"
*.style.stroke: "#333333"

# --- Entry ---

entry: |md
  **/eval-review**

  - --run-id <id> (required)
  - --config <path>
  - --cases <name>...
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Load results ---

load: |md
  **Load Results**

  - state.py read summary.yaml
  - eval.yaml (judges, schema)
  - analysis.md (if present)
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Walk cases (human-in-the-loop) ---

walk: |md
  **Walk Cases**

  - judge scores + rationale
  - summarize skill outputs
  - AskUserQuestion feedback
  - all / failures / specific
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Analyze transcripts (LLM sub-agent) ---

transcript: |md
  **Analyze Transcripts**
  Explore sub-agent (LLM)

  - read stdout.log per case
  - roundabout paths, retries
  - unnecessary tools, wasted turns
  - report inefficiencies
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 3
  style.double-border: true
}

# --- Analyze patterns ---

patterns: |md
  **Analyze Patterns**

  - judge-human alignment gaps
  - systematic vs case-specific
  - suggest new judge candidates
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Save feedback ---

save: |md
  **Save Feedback**

  - Write review.yaml directly
  - keyed by case dir
  - feeds /eval-optimize
  - feeds /eval-mlflow
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Propose edits (LLM) ---

propose: |md
  **Propose Edits**
  LLM, grounded in feedback

  - locate SKILL.md sections
  - before / after diffs
  - per-change rationale
| {
  shape: rectangle
  style.fill: "#e8e8e8"
  style.stroke: "#333333"
  style.stroke-width: 3
  style.double-border: true
}

# --- Decision ---

decide: |md
  **Approve edits?**
| {
  shape: diamond
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Apply + next steps ---

apply: |md
  **Apply + Next Steps**

  - edit SKILL.md / eval.yaml
  - /eval-run --baseline
  - /eval-optimize
  - /eval-mlflow
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#333333"
  style.stroke-width: 2
}

# --- Callout: primary output artifact ---

review-yaml: |md
  review.yaml
    run_id: "<id>"
    reviewed_cases: N
    feedback_cases: M
    reviewer: "human"
    feedback:
      <case-dir>: "reviewer notes"
      <case-dir>: ""   # empty = OK
| {
  shape: rectangle
  style.fill: "#f5f5f5"
  style.stroke: "#bbbbbb"
  style.stroke-width: 1
  style.font: mono
  style.font-size: 10
}

# --- Flow ---

entry -> load
load -> walk: "summary.yaml + analysis.md"
walk -> transcript: "stdout.log per case"
transcript -> patterns: "inefficiencies"
patterns -> save
save -> propose: "review.yaml"
propose -> decide: "before/after diffs"
decide -> apply: "approved"

# --- Back-edge (revise loop) ---

decide -> propose: "revise" {
  style.stroke-dash: 3
}

# --- Callout connector ---

save -> review-yaml: {
  style.stroke: "#bbbbbb"
  style.stroke-dash: 4
  style.stroke-width: 1
}
