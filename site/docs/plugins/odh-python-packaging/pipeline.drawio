    <mxCell id="secaudit" value="&lt;b&gt;python-packaging-security-audit&lt;/b&gt;&lt;br&gt;3 background agents - worst rating wins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ececec;strokeColor=#333333;strokeWidth=2;container=1;collapsible=0;verticalAlign=top;spacingTop=5;fontSize=12;fontStyle=1;fontFamily=Inter,Helvetica,Arial,sans-serif;arcSize=16;absoluteArcSize=1;" vertex="1" parent="dispatch">
