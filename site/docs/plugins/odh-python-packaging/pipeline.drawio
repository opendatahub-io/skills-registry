    <mxCell id="binary-audit" value="&lt;b&gt;python-packaging-binary-audit&lt;/b&gt;&lt;br&gt;&lt;br&gt;scan_binaries.py (Fromager-style)&lt;br&gt;run_malcontent.py YARA scan&lt;br&gt;Stage 1 rules, then Stage 2 AI&lt;br&gt;writes binary-audit.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333333;strokeWidth=3;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;double=1;arcSize=16;absoluteArcSize=1;" vertex="1" parent="secaudit">
