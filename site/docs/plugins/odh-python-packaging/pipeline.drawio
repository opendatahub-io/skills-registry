    <mxCell id="static-audit" value="&lt;b&gt;python-packaging-static-audit&lt;/b&gt;&lt;br&gt;&lt;br&gt;./scripts/run-hexora.sh {repo}&lt;br&gt;Stage 1 deterministic rules&lt;br&gt;Stage 2 AI reasoning&lt;br&gt;writes static-audit.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333333;strokeWidth=3;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;double=1;arcSize=16;absoluteArcSize=1;" vertex="1" parent="secaudit">
