    </mxCell>
    <mxCell id="git-audit" value="&lt;b&gt;python-packaging-git-audit&lt;/b&gt;&lt;br&gt;&lt;br&gt;git log -50 on sensitive files&lt;br&gt;eval/exec/base64/socket patterns&lt;br&gt;AI triage only, no Stage 1 rules&lt;br&gt;writes git-audit.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8e8;strokeColor=#333333;strokeWidth=3;verticalAlign=top;spacingTop=5;fontSize=11;fontFamily=Inter,Helvetica,Arial,sans-serif;double=1;arcSize=16;absoluteArcSize=1;" vertex="1" parent="secaudit">
